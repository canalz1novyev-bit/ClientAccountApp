<Page
    x:Class="ClientAccountApp.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NiatecBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
    Text="Инструменты"
    Style="{StaticResource NiatecPageTitleTextStyle}"/>

            <TextBlock
    Text="PDF, НДС и ИИ-инструменты для повседневной работы"
    Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
        </StackPanel>

        <TabView
            Grid.Row="1"
            IsAddTabButtonVisible="False"
            TabWidthMode="Equal">

            <!-- PDF -->
            <TabViewItem Header="PDF" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="16" Padding="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая карточка: конвертация -->
                        <Border
                Grid.Column="0"
                Style="{StaticResource NiatecCardBorderStyle}">

                            <StackPanel Spacing="14">
                                <TextBlock
                        Text="Конвертер в PDF"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                <TextBlock
                        Text="Выберите исходный файл, укажите путь сохранения и сформируйте PDF-документ."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <!-- Шаг 1 -->
                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Шаг 1. Исходный файл"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <Border
                                x:Name="SourceDropZoneBorder"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                AllowDrop="True"
                                DragOver="SourceDropZoneBorder_DragOver"
                                Drop="SourceDropZoneBorder_Drop">

                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <TextBlock
                                        Text="Перетащи файл сюда"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                        HorizontalAlignment="Center"/>

                                                <TextBlock
                                       Text="Или выберите файл через кнопку ниже. Если приложение запущено от администратора, drag &amp; drop из проводника может не работать."
                                        Style="{StaticResource NiatecCaptionTextStyle}"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBox
                                x:Name="SourceFileTextBox"
                                Header="Исходный файл"
                                IsReadOnly="True"
                                PlaceholderText="Файл пока не выбран"/>

                                        <Button
                                Content="Выбрать исходный файл"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="PickSourceFileButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Шаг 2 -->
                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Шаг 2. Путь сохранения"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <TextBox
                                x:Name="TargetPdfTextBox"
                                Header="Сохранить PDF как"
                                IsReadOnly="True"
                                PlaceholderText="Путь сохранения пока не выбран"/>

                                        <Button
                                Content="Выбрать путь сохранения PDF"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="PickTargetPdfButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Шаг 3 -->
                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Шаг 3. Конвертация"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button
                                    x:Name="ConvertToPdfButton"
                                    Grid.Column="0"
                                    Content="Конвертировать в PDF"
                                    Style="{StaticResource NiatecPrimaryButtonStyle}"
                                    IsEnabled="False"
                                    Click="ConvertToPdfButton_Click"/>

                                            <Button
                                    x:Name="OpenConvertedPdfButton"
                                    Grid.Column="1"
                                    Content="Открыть PDF"
                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                    IsEnabled="False"
                                    Click="OpenConvertedPdfButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <TextBlock
                            x:Name="ToolsStatusTextBlock"
                            Text="Выбери исходный файл и путь сохранения."
                            Foreground="{StaticResource NiatecAccentBrush}"
                            TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Правая карточка: будущие инструменты -->
                        <Border
                Grid.Column="1"
                Style="{StaticResource NiatecCardBorderStyle}">

                            <StackPanel Spacing="14">
                                <TextBlock
                        Text="Будущие PDF-инструменты"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                <TextBlock
                        Text="Этот раздел можно постепенно расширять дополнительными операциями с PDF-документами."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                Text="Планируемые функции"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <TextBlock
                                Text="• Объединение PDF"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBlock
                                Text="• Разделение PDF"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBlock
                                Text="• Сжатие PDF"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBlock
                                Text="• Проверка длинных путей файлов"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <TextBlock
                            Text="Совет: для файлов клиента удобнее использовать вкладку «Файлы» в карточке клиента — там документ можно сразу сохранить в структуру ClientFiles."
                            Foreground="{StaticResource NiatecTextSecondaryBrush}"
                            TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>

            <!-- НДС -->
            <TabViewItem Header="НДС" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="16" Padding="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая карточка: ввод данных -->
                        <Border
                Grid.Column="0"
                Style="{StaticResource NiatecCardBorderStyle}">

                            <StackPanel Spacing="14">
                                <TextBlock
                        Text="Калькулятор НДС"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                <TextBlock
                        x:Name="VatModeHintTextBlock"
                        Text="Режим: выделение НДС из суммы"
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Режим расчёта"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button
                                    x:Name="VatExtractModeButton"
                                    Grid.Column="0"
                                    Content="Выделить НДС"
                                    Style="{StaticResource NiatecPrimaryButtonStyle}"
                                    Click="VatExtractModeButton_Click"/>

                                            <Button
                                    x:Name="VatAddModeButton"
                                    Grid.Column="1"
                                    Content="Начислить НДС"
                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                    Click="VatAddModeButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBox
                        x:Name="VatAmountTextBox"
                        Header="Сумма"
                        PlaceholderText="Например: 125 000,50"
                        TextChanged="VatInputs_TextChanged"/>

                                <TextBox
                        x:Name="VatRateTextBox"
                        Header="Ставка НДС, %"
                        Text="22"
                        TextChanged="VatInputs_TextChanged"/>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Быстрый выбор ставки"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Row="0" Grid.Column="0" Content="22%" Tag="22" Style="{StaticResource NiatecSecondaryButtonStyle}" Click="VatPresetRateButton_Click"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="20%" Tag="20" Style="{StaticResource NiatecSecondaryButtonStyle}" Click="VatPresetRateButton_Click"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="10%" Tag="10" Style="{StaticResource NiatecSecondaryButtonStyle}" Click="VatPresetRateButton_Click"/>

                                            <Button Grid.Row="1" Grid.Column="0" Content="7%" Tag="7" Style="{StaticResource NiatecSecondaryButtonStyle}" Click="VatPresetRateButton_Click"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="5%" Tag="5" Style="{StaticResource NiatecSecondaryButtonStyle}" Click="VatPresetRateButton_Click"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="0%" Tag="0" Style="{StaticResource NiatecSecondaryButtonStyle}" Click="VatPresetRateButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button
                            Grid.Column="0"
                            Content="Очистить"
                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                            Click="ClearVatButton_Click"/>

                                    <Button
                            Grid.Column="1"
                            Content="Скопировать"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            Click="CopyVatResultButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Правая карточка: результат -->
                        <Border
                Grid.Column="1"
                Style="{StaticResource NiatecCardBorderStyle}">

                            <StackPanel Spacing="14">
                                <TextBlock
                        Text="Результат"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                <TextBlock
                        Text="Расчёт обновляется автоматически после ввода суммы или изменения ставки."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Сумма НДС"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBox
                                x:Name="VatResultVatTextBox"
                                Text="НДС: —"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                AcceptsReturn="False"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Разбивка суммы"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBox
                                x:Name="VatResultNetTextBox"
                                Text="Без НДС: —"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                AcceptsReturn="False"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Padding="10,8"/>

                                        <TextBox
                                x:Name="VatResultGrossTextBox"
                                Text="С НДС: —"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                AcceptsReturn="False"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <TextBlock
                            x:Name="VatStatusTextBlock"
                            Text="Введи сумму и при необходимости измени ставку."
                            Foreground="{StaticResource NiatecAccentBrush}"
                            TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="395 ГК РФ" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="16" Padding="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая карточка: параметры расчёта -->
                        <Border
                Grid.Column="0"
                Style="{StaticResource NiatecCardBorderStyle}">

                            <StackPanel Spacing="14">
                                <TextBlock
                        Text="Расчёт процентов по ст. 395 ГК РФ"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                <TextBlock
                        Text="Расчёт процентов за просрочку денежного обязательства. Текущий вариант использует одну ставку за весь период."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Шаг 1. Сумма задолженности"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <TextBox
                                x:Name="Civil395DebtTextBox"
                                Header="Сумма долга"
                                PlaceholderText="Например: 100 000"
                                TextChanged="Civil395Inputs_TextChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Шаг 2. Период просрочки"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DatePicker
                                    x:Name="Civil395StartDatePicker"
                                    Grid.Column="0"
                                    Header="Дата начала"
                                    DateChanged="Civil395DatePicker_DateChanged"/>

                                            <DatePicker
                                    x:Name="Civil395EndDatePicker"
                                    Grid.Column="1"
                                    Header="Дата окончания"
                                    DateChanged="Civil395DatePicker_DateChanged"/>
                                        </Grid>

                                        <CheckBox
                                x:Name="Civil395IncludeEndDateCheckBox"
                                Content="Включить последний день"
                                IsChecked="True"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                Checked="Civil395IncludeEndDateCheckBox_Changed"
                                Unchecked="Civil395IncludeEndDateCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Шаг 3. Ставка"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <TextBox
                                x:Name="Civil395RateTextBox"
                                Header="Ставка, % годовых"
                                Text="15"
                                TextChanged="Civil395Inputs_TextChanged"/>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button
                            Grid.Column="0"
                            Content="Рассчитать"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            Click="CalculateCivil395Button_Click"/>

                                    <Button
                            Grid.Column="1"
                            Content="Очистить"
                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                            Click="ClearCivil395Button_Click"/>

                                    <Button
                            Grid.Column="2"
                            Content="Скопировать"
                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                            Click="CopyCivil395ResultButton_Click"/>
                                </Grid>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <TextBlock
                            x:Name="Civil395StatusTextBlock"
                            Text="Введите сумму, период и ставку."
                            Foreground="{StaticResource NiatecAccentBrush}"
                            TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Правая карточка: результат -->
                        <Border
                Grid.Column="1"
                Style="{StaticResource NiatecCardBorderStyle}">

                            <StackPanel Spacing="14">
                                <TextBlock
                        Text="Результат"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                <TextBlock
                        Text="Итоговый расчёт можно скопировать и использовать как черновик для претензии или расчёта."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Период"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBox
                                x:Name="Civil395DaysResultTextBox"
                                Text="Дней просрочки: —"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Проценты"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBox
                                x:Name="Civil395InterestResultTextBox"
                                Text="Проценты: —"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Padding="10,8"/>

                                        <TextBox
                                x:Name="Civil395TotalResultTextBox"
                                Text="Итого к взысканию: —"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                Text="Формула"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                                        <TextBox
                                x:Name="Civil395FormulaResultTextBox"
                                Text="Формула: —"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="120"
                                Background="{StaticResource NiatecBackgroundBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                Text="Важно"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                                        <TextBlock
                                Text="Это упрощённый вариант расчёта по одной ставке. Для судебного расчёта за длительный период позже можно добавить разбивку по изменениям ключевой ставки ЦБ."
                                Style="{StaticResource NiatecCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>

            
            <!-- ИИ -->
            <TabViewItem Header="ИИ" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,16,0,0">

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.95*"/>
                                <ColumnDefinition Width="1.05*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая карточка: автоматическая проверка контрагента -->
                            <Border
                    Grid.Column="0"
                    Style="{StaticResource NiatecCardBorderStyle}">

                                <StackPanel Spacing="14">
                                    <TextBlock
                            Text="Автоматическая проверка контрагента"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                    <TextBlock
                            Text="Введите ИНН. Приложение само соберёт доступные внешние сведения, а ИИ подготовит отчёт по результатам проверки."
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                                    <TextBox
                            x:Name="CounterpartyInnTextBox"
                            Header="ИНН контрагента"
                            PlaceholderText="Например: 7707083893"/>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button
                                x:Name="RunCounterpartyAutoCheckButton"
                                Grid.Column="0"
                                Content="Проверить автоматически"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="RunCounterpartyAutoCheckButton_Click"/>

                                        <Button
                                x:Name="GenerateCounterpartyAiReportButton"
                                Grid.Column="1"
                                Content="Сформировать ИИ-отчёт"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="GenerateCounterpartyAiReportButton_Click"/>
                                    </Grid>
                                    <Button
    x:Name="DownloadCounterpartyPdfReportButton"
    Content="Скачать PDF-отчёт"
    Style="{StaticResource NiatecSecondaryButtonStyle}"
    HorizontalAlignment="Left"
    IsEnabled="False"
    Click="DownloadCounterpartyPdfReportButton_Click"/>

                                    <TextBox
                            x:Name="CounterpartyReportTextBox"
                            Header="Результат проверки"
                            PlaceholderText="После автоматической проверки здесь появится сводка по источникам."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsReadOnly="True"
                            Height="500"/>

                                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                        <TextBlock
                                Text="Важно: пользователь не ищет сведения вручную. Приложение автоматически собирает факты, а ИИ анализирует только полученную сводку."
                                Foreground="{StaticResource NiatecAccentBrush}"
                                TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Правая карточка: ответ на требование ФНС -->
                            <Border
                    Grid.Column="1"
                    Style="{StaticResource NiatecCardBorderStyle}">

                                <StackPanel Spacing="14">
                                    <TextBlock
                            Text="Ответ на требование ФНС"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                                    <TextBlock
                            Text="Загрузите требование ФНС. ИИ подготовит черновик официального ответа от имени выбранной организации."
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                    Text="Клиент / налогоплательщик"
                                    Foreground="{StaticResource NiatecAccentBrush}"
                                    FontWeight="SemiBold"/>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                        x:Name="TaxRequirementClientComboBox"
                                        Grid.Column="0"
                                        DisplayMemberPath="Name"
                                        PlaceholderText="Выберите клиента, по которому готовится ответ"/>

                                                <Button
                                        Grid.Column="1"
                                        Content="Обновить клиентов"
                                        Height="40"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource NiatecSecondaryButtonStyle}"
                                        Click="RefreshTaxRequirementClientsButton_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBox
                            x:Name="TaxRequirementFileTextBox"
                            Header="Файл требования"
                            IsReadOnly="True"
                            PlaceholderText="Файл пока не выбран"/>

                                    <Button
                            Content="Выбрать требование ФНС"
                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="PickTaxRequirementFileButton_Click"/>

                                    <TextBox
                            x:Name="TaxRequirementPreviewTextBox"
                            Header="Извлечённый текст требования"
                            PlaceholderText="На следующем шаге подключим извлечение текста из PDF / Word / XML / TXT."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsReadOnly="True"
                            Height="220"/>

                                    <Button
                            Content="Сформировать Word-ответ"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="GenerateTaxRequirementResponseButton_Click"/>

                                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                                        <TextBlock
                                Text="Важно: ИИ формирует черновик. Перед отправкой в ФНС документ необходимо проверить вручную."
                                Foreground="{StaticResource NiatecAccentBrush}"
                                TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Общий статус ИИ-инструментов -->
                        <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                            <TextBlock
                    x:Name="AiStatusTextBlock"
                    Text="ИИ-раздел готов к работе."
                    Foreground="{StaticResource NiatecAccentBrush}"
                    TextWrapping="Wrap"/>
                        </Border>

                        <!-- Скрытый блок совместимости.
                 Настройки GigaChat уже вынесены в Settings,
                 но старые методы ToolsPage.xaml.cs пока используют эти элементы. -->
                        <StackPanel Visibility="Collapsed">
                            <CheckBox x:Name="GigaChatEnabledCheckBox"/>

                            <TextBox x:Name="GigaChatOAuthUrlTextBox"/>
                            <TextBox x:Name="GigaChatApiUrlTextBox"/>
                            <TextBox x:Name="GigaChatModelTextBox"/>

                            <ComboBox x:Name="GigaChatScopeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="GIGACHAT_API_PERS"/>
                                <ComboBoxItem Content="GIGACHAT_API_B2B"/>
                                <ComboBoxItem Content="GIGACHAT_API_CORP"/>
                            </ComboBox>

                            <PasswordBox x:Name="GigaChatAuthorizationKeyPasswordBox"/>

                            <Button Click="SaveAiSettingsButton_Click"/>
                            <Button Click="TestGigaChatButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>