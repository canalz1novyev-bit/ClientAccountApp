<Page
    x:Class="ClientAccountApp.OrganizationSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Background="{StaticResource NiatecBackgroundBrush}"
            Padding="16"
            RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="OrganizationSetupTitleTextBlock"
                    Text="Создание организации"
                    Style="{StaticResource NiatecPageTitleTextStyle}"/>

                <TextBlock
                    Text="Заполните данные организации, от имени которой будут формироваться договоры, счета и УПД."
                    Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            </StackPanel>

            <!-- Основная карточка -->
            <Border
                Grid.Row="1"
                MaxWidth="980"
                HorizontalAlignment="Left"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="16">

                    <!-- Основные реквизиты -->
                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="Основные реквизиты"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="OrganizationInnTextBox"
                                    Grid.Column="0"
                                    Header="ИНН"
                                    PlaceholderText="Введите ИНН организации"/>

                                <Button
                                    Grid.Column="1"
                                    x:Name="FillOrganizationByInnButton"
                                    Content="Заполнить по ИНН"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                    Click="FillOrganizationByInnButton_Click"/>
                            </Grid>

                            <TextBox
                                x:Name="OrganizationNameTextBox"
                                Header="Наименование организации"
                                PlaceholderText="Например: ООО «НИАТЕК»"/>

                            <TextBox
                                x:Name="OrganizationShortNameTextBox"
                                Header="Краткое название"
                                PlaceholderText="Например: НИАТЕК"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="OrganizationKppTextBox"
                                    Grid.Column="0"
                                    Header="КПП"/>

                                <TextBox
                                    x:Name="OrganizationOgrnTextBox"
                                    Grid.Column="1"
                                    Header="ОГРН / ОГРНИП"/>
                            </Grid>

                            <TextBox
                                x:Name="OrganizationLegalAddressTextBox"
                                Header="Юридический адрес"
                                PlaceholderText="Юридический адрес организации"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="OrganizationDirectorNameTextBox"
                                    Grid.Column="0"
                                    Header="Руководитель / подписант"
                                    PlaceholderText="Например: Иванов Иван Иванович"/>

                                <TextBox
                                    x:Name="OrganizationDirectorPositionTextBox"
                                    Grid.Column="1"
                                    Header="Должность"
                                    Text="Директор"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Банковские реквизиты -->
                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="Банковские реквизиты"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                            <TextBox
                                x:Name="OrganizationBankNameTextBox"
                                Header="Банк"
                                PlaceholderText="Наименование банка"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="OrganizationSettlementAccountTextBox"
                                    Grid.Column="0"
                                    Header="Расчётный счёт"/>

                                <TextBox
                                    x:Name="OrganizationBankBicTextBox"
                                    LostFocus="OrganizationBankBicTextBox_LostFocus"
                                    Grid.Column="1"
                                    Header="БИК"/>
                            </Grid>

                            <TextBox
                                x:Name="OrganizationCorrespondentAccountTextBox"
                                Header="Корреспондентский счёт"/>
                        </StackPanel>
                    </Border>

                    <!-- Контакты и логотип -->
                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="Контакты и логотип"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="OrganizationEmailTextBox"
                                    Grid.Column="0"
                                    Header="E-mail"/>

                                <TextBox
                                    x:Name="OrganizationPhoneTextBox"
                                    Grid.Column="1"
                                    Header="Телефон"/>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="OrganizationLogoPathTextBox"
                                    Grid.Column="0"
                                    Header="Файл логотипа"
                                    IsReadOnly="True"
                                    PlaceholderText="Логотип пока не выбран"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Выбрать логотип"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                    Click="PickOrganizationLogoButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Действия -->
                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="Действия"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    x:Name="SaveOrganizationButton"
                                    Content="Сохранить и войти"
                                    Style="{StaticResource NiatecPrimaryButtonStyle}"
                                    Click="SaveOrganizationButton_Click"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Выбрать другую организацию"
                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                    Click="OpenOrganizationSelectButton_Click"/>
                            </Grid>

                            <TextBlock
                                x:Name="OrganizationSetupStatusTextBlock"
                                Text=""
                                Foreground="{StaticResource NiatecAccentBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>