<Page
    x:Class="ClientAccountApp.ContractsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#0F1115" Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Договоры"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Реестр договорного цикла по клиентам"
                        FontSize="13"
                        Foreground="#9AA4B2"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="Обновить"
                    MinWidth="140"
                    Height="40"
                    VerticalAlignment="Top"
                    Click="RefreshContractsButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="14" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBox
    x:Name="ContractsSearchTextBox"
    Grid.Column="0"
    Header="Поиск"
    MinWidth="320"
    PlaceholderText="Поиск по клиенту, ИНН, номеру договора"
    TextChanged="ContractsSearchTextBox_TextChanged"/>

                <ComboBox
    x:Name="ContractStatusFilterComboBox"
    Grid.Column="1"
    Header="Статус договора"
    MinWidth="220"
    SelectedIndex="1"
    SelectionChanged="ContractStatusFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Требует договора"/>
                    <ComboBoxItem Content="Договор сформирован"/>
                    <ComboBoxItem Content="Договор подписан"/>
                </ComboBox>

                <ComboBox
    x:Name="ContractsSortComboBox"
    Grid.Column="2"
    Header="Сортировка"
    SelectedIndex="0"
    SelectionChanged="ContractsSortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Сначала требующие внимания"/>
                    <ComboBoxItem Content="По дате формирования"/>
                    <ComboBoxItem Content="По названию клиента"/>
                </ComboBox>

                <Button
                    Grid.Column="3"
                    Content="Сбросить"
                    Height="40"
                    VerticalAlignment="Bottom"/>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="#171A21"
                    BorderBrush="#2B3140"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Всего договоров" Foreground="#8F9BB3"/>
                        <TextBlock
                            x:Name="ContractsTotalCountTextBlock"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="#171A21"
                    BorderBrush="#2B3140"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Требует договора" Foreground="#8F9BB3"/>
                        <TextBlock
                            x:Name="ContractsNeedCountTextBlock"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#B8B8B8"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Background="#171A21"
                    BorderBrush="#2B3140"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Сформированы" Foreground="#8F9BB3"/>
                        <TextBlock
                            x:Name="ContractsGeneratedCountTextBlock"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#D7BA7D"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="3"
                    Background="#171A21"
                    BorderBrush="#2B3140"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Подписаны" Foreground="#8F9BB3"/>
                        <TextBlock
                            x:Name="ContractsSignedCountTextBlock"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#73C991"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Background="#171A21"
                BorderBrush="#2B3140"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Список договоров"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Рабочая очередь по договорам"
                            Foreground="#8F9BB3"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <ListView
                        x:Name="ContractsListView"
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Single">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="#11151C"
                                    BorderBrush="#243042"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="290"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    Background="{Binding StatusBrush}"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0">
                                                    <TextBlock
                                                        Text="{Binding StatusIcon}"
                                                        Foreground="White"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"/>
                                                </Border>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ClientName}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    TextWrapping="Wrap"/>
                                            </Grid>

                                            <TextBlock
                                                Text="{Binding ClientMetaText}"
                                                Foreground="#B8B8B8"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding ContractStatusText}"
                                                Foreground="{Binding StatusTextBrush}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Номер договора" Foreground="#8F9BB3"/>
                                            <TextBlock Text="{Binding ContractNumber}" Foreground="White"/>

                                            <TextBlock Text="Сформирован" Foreground="#8F9BB3" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding GeneratedAtText}" Foreground="White"/>

                                            <TextBlock Text="Подписан" Foreground="#8F9BB3" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding SignedAtText}" Foreground="White"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="8">
                                            <Button Content="Открыть клиента" Click="OpenClientButton_Click"/>
                                            <Button
    Content="{Binding ContractFileButtonText}"
    Click="OpenContractButton_Click"/>
                                            <Button Content="Открыть папку клиента" Click="OpenClientFolderButton_Click"/>
                                            <Button
    Content="{Binding SignToggleButtonText}"
    IsEnabled="{Binding CanToggleSigned}"
    Click="MarkContractSignedButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="2"
                        Background="#11151C"
                        BorderBrush="#243042"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,10,0,0">
                        <TextBlock
                            x:Name="ContractsEmptyStateTextBlock"
                            Text="Пока нет договоров для отображения."
                            Foreground="#8F9BB3"
                            TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>