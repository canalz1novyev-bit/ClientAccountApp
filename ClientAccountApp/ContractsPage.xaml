<Page
    x:Class="ClientAccountApp.ContractsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearchAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <DataTemplate x:Key="CompactContractItemTemplate">
            <Border
            Background="{StaticResource NiatecSurfaceAltBrush}"
            BorderBrush="{StaticResource NiatecBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Margin="0,0,0,6">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                        Text="{Binding ClientName}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                        Text="{Binding ClientMetaText}"
                        FontSize="11"
                        Foreground="{StaticResource NiatecTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock
                    Grid.Column="1"
                    Text="{Binding ContractStatusText}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding StatusTextBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"/>

                    <TextBlock
                    Grid.Column="2"
                    Text="{Binding ContractNumber}"
                    FontSize="12"
                    Foreground="{StaticResource NiatecTextPrimaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                        Text="{Binding GeneratedAtText}"
                        FontSize="11"
                        Foreground="{StaticResource NiatecTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                        Text="{Binding SignedAtText}"
                        FontSize="11"
                        Foreground="{StaticResource NiatecTextMutedBrush}"
                        TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel
                    Grid.Column="4"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                        <Button
                        Content="Клиент"
                        Style="{StaticResource NiatecSecondaryButtonStyle}"
                        Click="OpenClientButton_Click"/>

                        <Button
                        Content="Мастер"
                        Style="{StaticResource NiatecSecondaryButtonStyle}"
                        ToolTipService.ToolTip="Создать договор через мастер"
                        Click="OpenContractWizardForClientButton_Click"/>

                        <Button
                        Content="Договор"
                        Style="{StaticResource NiatecPrimaryButtonStyle}"
                        Click="OpenContractButton_Click"/>

                        <Button
                        Content="Папка"
                        Style="{StaticResource NiatecSecondaryButtonStyle}"
                        Click="OpenClientFolderButton_Click"/>

                        <Button
    Content="{Binding SignToggleButtonText}"
    MinWidth="96"
    IsEnabled="{Binding CanToggleSigned}"
    Style="{StaticResource NiatecSecondaryButtonStyle}"
    ToolTipService.ToolTip="Отметить договор подписанным"
    Click="MarkContractSignedButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Background="{StaticResource NiatecBackgroundBrush}"
            Padding="16"
            RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Договоры"
                        Style="{StaticResource NiatecPageTitleTextStyle}"/>

                    <TextBlock
                        Text="Реестр договорного цикла по клиентам"
                        Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
                </StackPanel>

            </Grid>

            <!-- Фильтры -->
            <Grid Grid.Row="1" ColumnSpacing="14" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <TextBox
        x:Name="ContractsSearchTextBox"
        Grid.Column="0"
        Header="Поиск"
        MinWidth="320"
        PlaceholderText="Поиск по клиенту, ИНН, номеру договора"
        TextChanged="ContractsSearchTextBox_TextChanged"/>

                <ComboBox
    x:Name="ContractStatusFilterComboBox"
    Grid.Column="1"
    Header="Статус договора"
    MinWidth="240"
    SelectedIndex="0"
    SelectionChanged="ContractStatusFilterComboBox_SelectionChanged">

                    <ComboBoxItem Content="Все договоры"/>
                    <ComboBoxItem Content="Требует подписания"/>
                    <ComboBoxItem Content="Договор подписан"/>
                </ComboBox>
            </Grid>

            <!-- Карточки показателей -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Всего договоров"
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <TextBlock
                            x:Name="ContractsTotalCountTextBlock"
                            Text="0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Требует договора"
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <TextBlock
                            x:Name="ContractsNeedCountTextBlock"
                            Text="0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NiatecTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Сформированы"
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <TextBlock
                            x:Name="ContractsGeneratedCountTextBlock"
                            Text="0"
                            Style="{StaticResource NiatecMetricNumberTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Подписаны"
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <TextBlock
                            x:Name="ContractsSignedCountTextBlock"
                            Text="0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NiatecSuccessBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Список договоров -->
            <Border
                Grid.Row="3"
                Style="{StaticResource NiatecCardBorderStyle}">

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
        Text="Список договоров"
        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                        <TextBlock
        Grid.Column="1"
        Text="Рабочая очередь по договорам"
        Style="{StaticResource NiatecMutedTextStyle}"
        VerticalAlignment="Center"/>

                        <Button
        Grid.Column="2"
        Content="＋ Мастер договоров"
        Style="{StaticResource NiatecPrimaryButtonStyle}"
        ToolTipService.ToolTip="Создать новый договор через пошаговый мастер"
        Click="OpenContractWizardPageButton_Click"/>

                        <Button
        x:Name="ToggleContractsViewButton"
        Grid.Column="3"
        Style="{StaticResource NiatecSmallIconButtonStyle}"
        ToolTipService.ToolTip="Компактный вид списка"
        Click="ToggleContractsViewButton_Click">

                            <TextBlock
            Text="☰"
            FontSize="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="ContractsListView"
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Single">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{StaticResource NiatecSurfaceAltBrush}"
                                    BorderBrush="{StaticResource NiatecBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="290"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Клиент и статус -->
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock
                                                Text="{Binding ClientName}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding ClientMetaText}"
                                                Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding ContractStatusText}"
                                                Foreground="{Binding StatusTextBrush}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Реквизиты договора — строки с разделителями -->
                                        <Border Grid.Column="1"
                                                Background="{StaticResource NiatecSurfaceBrush}"
                                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="12,2">
                                            <StackPanel>
                                                <Grid Padding="0,8" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Номер" FontSize="12"
                                                               Foreground="{StaticResource NiatecTextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ContractNumber}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource NiatecBorderBrush}" CornerRadius="0"/>
                                                <Grid Padding="0,8" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Сформирован" FontSize="12"
                                                               Foreground="{StaticResource NiatecTextMutedBrush}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GeneratedAtText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource NiatecBorderBrush}" CornerRadius="0"/>
                                                <Grid Padding="0,8" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Подписан" FontSize="12"
                                                               Foreground="{StaticResource NiatecTextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SignedAtText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Действия -->
                                        <StackPanel Grid.Column="2" Spacing="8">
                                            <Button
                                                Content="Открыть клиента"
                                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                Click="OpenClientButton_Click"/>

                                            <Button
                                                Content="Мастер договоров"
                                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                ToolTipService.ToolTip="Создать договор через мастер"
                                                Click="OpenContractWizardForClientButton_Click"/>

                                            <Button
                                                Content="{Binding ContractFileButtonText}"
                                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                                Click="OpenContractButton_Click"/>

                                            <Button
                                                Content="Открыть папку клиента"
                                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                Click="OpenClientFolderButton_Click"/>

                                            <Button
                                                Content="{Binding SignToggleButtonText}"
                                                IsEnabled="{Binding CanToggleSigned}"
                                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                Click="MarkContractSignedButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="2"
                        Style="{StaticResource NiatecInnerPanelBorderStyle}"
                        Margin="0,10,0,0">

                        <TextBlock
                            x:Name="ContractsEmptyStateTextBlock"
                            Text="Пока нет договоров для отображения."
                            Style="{StaticResource NiatecCaptionTextStyle}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>