<Page
    x:Class="ClientAccountApp.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientAccountApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  
    <Page.Resources>
        <DataTemplate x:Key="NormalClientItemTemplate" x:DataType="local:ClientInfo">
            <Border
                Tag="ClientCardRoot"
                Background="{StaticResource NiatecSurfaceAltBrush}"
                BorderBrush="{StaticResource NiatecBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,10"
                RightTapped="ClientCard_RightTapped">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="18" Height="18" CornerRadius="9"
                        Background="{x:Bind StatusBadgeBackgroundBrush}"
                        Visibility="{x:Bind StatusBadgeVisibility}"
                        VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.75">
                        <TextBlock Text="{x:Bind StatusBadgeText}"
                            Foreground="{StaticResource NiatecTextPrimaryBrush}"
                            FontSize="10" FontWeight="SemiBold"
                            HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"
                            Foreground="{StaticResource NiatecTextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ClientListMetaText}"
                            Foreground="{StaticResource NiatecTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
        Background="{x:Bind BusinessCategoryChipBackgroundBrush}"
        CornerRadius="8"
        Padding="8,2">
                                <TextBlock
            Text="{x:Bind BusinessCategoryChipText}"
            Foreground="{x:Bind BusinessCategoryChipForegroundBrush}"
            FontSize="11"
            FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock
        Text="{x:Bind MainOkvedDisplayText}"
        Foreground="{StaticResource NiatecTextMutedBrush}"
        FontSize="11"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind SignatureWarningText}"
                            Foreground="{StaticResource NiatecWarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind AccountShortInfo}"
                            Foreground="{StaticResource NiatecAccentBlueBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Address}"
                            Foreground="{StaticResource NiatecTextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactClientItemTemplate" x:DataType="local:ClientInfo">
            <Border
                Tag="ClientCardRoot"
                Background="{StaticResource NiatecSurfaceAltBrush}"
                BorderBrush="{StaticResource NiatecBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6"
                RightTapped="ClientCard_RightTapped">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="16" Height="16" CornerRadius="8"
                        Background="{x:Bind StatusBadgeBackgroundBrush}"
                        Visibility="{x:Bind StatusBadgeVisibility}"
                        VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.75">
                        <TextBlock Text="{x:Bind StatusBadgeText}"
                            Foreground="{StaticResource NiatecTextPrimaryBrush}"
                            FontSize="9" FontWeight="SemiBold"
                            HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1"
            Spacing="3"
            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}"
               Foreground="{StaticResource NiatecTextPrimaryBrush}"
               FontSize="13"
               FontWeight="SemiBold"
               TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ClientType}"
                   Foreground="{StaticResource NiatecTextMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

                            <Border
            Background="{x:Bind BusinessCategoryChipBackgroundBrush}"
            CornerRadius="7"
            Padding="6,1">
                                <TextBlock
                Text="{x:Bind BusinessCategoryChipText}"
                Foreground="{x:Bind BusinessCategoryChipForegroundBrush}"
                FontSize="10"
                FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DenseClientItemTemplate" x:DataType="local:ClientInfo">
            <Border
        Tag="ClientCardRoot"
        Background="{StaticResource NiatecSurfaceAltBrush}"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="0,0,0,1"
        Padding="8,8"
        RightTapped="ClientCard_RightTapped">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <!-- Статус -->
                    <Border Grid.Column="0"
                    Width="16"
                    Height="16"
                    CornerRadius="8"
                    Background="{x:Bind StatusBadgeBackgroundBrush}"
                    Visibility="{x:Bind StatusBadgeVisibility}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0.75">
                        <TextBlock Text="{x:Bind StatusBadgeText}"
                           Foreground="{StaticResource NiatecTextPrimaryBrush}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>
                    </Border>

                    <!-- Клиент -->
                    <StackPanel Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}"
                           Foreground="{StaticResource NiatecTextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ClientTypeAndBusinessCategoryText}"
    Foreground="{StaticResource NiatecTextMutedBrush}"
    FontSize="11"
    TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- ИНН -->
                    <TextBlock Grid.Column="2"
                       Text="{x:Bind Inn}"
                       Foreground="{StaticResource NiatecTextSecondaryBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

                    <!-- ЭЦП -->
                    <TextBlock Grid.Column="3"
                       Text="{x:Bind SignatureShortInfo}"
                       Foreground="{StaticResource NiatecWarningBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

                    <!-- Счета -->
                    <TextBlock Grid.Column="4"
                       Text="{x:Bind AccountCount}"
                       Foreground="{StaticResource NiatecAccentBlueBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                    <!-- Заметки -->
                    <TextBlock Grid.Column="5"
                       Text="{x:Bind NoteCount}"
                       Foreground="{StaticResource NiatecAccentBlueBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource NiatecBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="ClientsSectionGrid" Grid.Column="2" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Клиенты" FontSize="30" FontWeight="SemiBold"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                    <TextBlock Text="Рабочая база клиентов с ЭЦП, счетами, заметками и файлами"
                        FontSize="13" Foreground="{StaticResource NiatecTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
        x:Name="SearchTextBox"
        Grid.Column="0"
        Header="Поиск"
        PlaceholderText="Поиск по названию, ИНН, адресу, категории, ОКВЭД"
        TextChanged="SearchTextBox_TextChanged"/>

                    <ComboBox
        x:Name="BusinessCategoryFilterComboBox"
        Grid.Column="1"
        Header="Категория"
        SelectedIndex="0"
        SelectionChanged="BusinessCategoryFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="Все категории"/>
                        <ComboBoxItem Content="Не указано"/>
                        <ComboBoxItem Content="Торговля"/>
                        <ComboBoxItem Content="Перевозки / логистика"/>
                        <ComboBoxItem Content="С/Х"/>
                        <ComboBoxItem Content="IT / связь"/>
                        <ComboBoxItem Content="Строительство"/>
                        <ComboBoxItem Content="Производство"/>
                        <ComboBoxItem Content="Гостиницы / общепит"/>
                        <ComboBoxItem Content="Юр. / бух. / консалтинг"/>
                        <ComboBoxItem Content="Недвижимость"/>
                        <ComboBoxItem Content="Медицина / соцуслуги"/>
                        <ComboBoxItem Content="Образование"/>
                        <ComboBoxItem Content="Услуги населению"/>
                        <ComboBoxItem Content="Прочее"/>
                    </ComboBox>
                </Grid>
                <ComboBox x:Name="SignatureFilterComboBox" Visibility="Collapsed"
                    SelectedIndex="0" SelectionChanged="SignatureFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все клиенты"/>
                    <ComboBoxItem Content="ЭЦП истекает в 30 дней"/>
                    <ComboBoxItem Content="ЭЦП истекает в 7 дней"/>
                    <ComboBoxItem Content="ЭЦП уже истекла"/>
                </ComboBox>
                <ComboBox x:Name="StatusFilterComboBox" Visibility="Collapsed"
                    SelectedIndex="0" SelectionChanged="StatusFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все статусы"/>
                    <ComboBoxItem Content="Активный"/>
                    <ComboBoxItem Content="На продлении"/>
                    <ComboBoxItem Content="Проблемный"/>
                    <ComboBoxItem Content="Архив"/>
                    <ComboBoxItem Content="Новый"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Список клиентов -->
                    <ColumnDefinition Width="1.45*" MinWidth="540"/>

                    <!-- Разделитель -->
                    <ColumnDefinition Width="12"/>

                    <!-- Карточка клиента -->
                    <ColumnDefinition Width="1.55*" MinWidth="620"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: список клиентов -->
                <Border Grid.Column="0"
    Background="{StaticResource NiatecSurfaceBrush}"
    CornerRadius="14"
    Padding="10"
    BorderBrush="{StaticResource NiatecBorderBrush}"
    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid MinHeight="42" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
        Grid.Column="0"
        Text="Список клиентов"
        FontSize="20"
        FontWeight="SemiBold"
        Foreground="{StaticResource NiatecTextPrimaryBrush}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"/>

                            <Button
    x:Name="AddClientQuickButton"
    Grid.Column="1"
    Width="38"
    Height="38"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Padding="0"
    ToolTipService.ToolTip="Добавить клиента"
    Style="{StaticResource NiatecPrimaryButtonStyle}"
    Click="AddClientQuickButton_Click">

                                <FontIcon
        Glyph="&#xE710;"
        FontFamily="Segoe MDL2 Assets"
        FontSize="16"/>
                            </Button>

                            <ToggleButton
        x:Name="ClientViewModeToggleButton"
        Grid.Column="2"
        Width="38"
        Height="38"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Background="{StaticResource NiatecSurfaceAltBrush}"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="1"
        Click="ClientViewModeToggleButton_Click">

                                <TextBlock
            x:Name="ClientViewModeGlyphTextBlock"
            Text="▦"
            FontSize="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
                            </ToggleButton>
                        </Grid>
                        <Grid x:Name="DenseClientsHeaderGrid"
      Grid.Row="1"
      ColumnSpacing="10"
      Visibility="Collapsed"
      Margin="0,8,0,6"
      VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1"
               Text="Клиент"
               Foreground="{StaticResource NiatecTextMutedBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
               Text="ИНН"
               Foreground="{StaticResource NiatecTextMutedBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
               Text="ЭЦП"
               Foreground="{StaticResource NiatecTextMutedBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4"
               Text="Счета"
               Foreground="{StaticResource NiatecTextMutedBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="5"
               Text="Заметки"
               Foreground="{StaticResource NiatecTextMutedBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                        </Grid>
                        <ListView x:Name="ClientsListView" Grid.Row="2"
                            SelectionChanged="ClientsListView_SelectionChanged"
                            SelectionMode="Single" Background="Transparent" BorderThickness="0"
                            ItemTemplate="{StaticResource NormalClientItemTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Правая колонка: вкладки -->
                <TabView
    x:Name="ClientDetailsTabView"
    Grid.Column="2"
    Margin="0"
    IsAddTabButtonVisible="False"
    TabWidthMode="Equal"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
                    <TabViewItem Header="Обзор" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="0">

                                <!-- Главная карточка клиента -->
                                <Border Background="{StaticResource NiatecSurfaceBrush}"
                    CornerRadius="16"
                    Padding="16"
                    BorderBrush="{StaticResource NiatecBorderBrush}"
                    BorderThickness="1">

                                    <StackPanel Spacing="14">

                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="OverviewClientTitleTextBlock"
                                       Text="Клиент не выбран"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>

                                                <TextBlock x:Name="OverviewClientMetaTextBlock"
                                       Text="Выберите клиента слева"
                                       FontSize="13"
                                       Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                                                <TextBlock x:Name="OverviewClientBusinessTextBlock"
                                       Text="Категория: — · ОКВЭД: —"
                                       FontSize="13"
                                       Foreground="{StaticResource NiatecAccentBlueBrush}"
                                       TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Visibility="Collapsed"
                                Background="{StaticResource NiatecSurfaceAltBrush}"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,8"
                                VerticalAlignment="Top">
                                                <TextBlock x:Name="OverviewClientStatusTextBlock"
                                       Text="—"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Быстрые действия -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="QuickNewInvoiceButton"
        Grid.Column="0"
        Content="+ Новый счёт"
        Height="36"
        FontSize="12"
        Style="{StaticResource NiatecPrimaryButtonStyle}"
        Click="QuickNewInvoiceButton_Click"/>

                                            <Button Grid.Column="1"
                                Content="Экспорт Word"
                                Height="36"
                                FontSize="12"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="ExportClientCardToWordButton_Click"/>

                                            <Button Grid.Column="2"
                                Content="Выписка"
                                Height="36"
                                FontSize="12"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="DownloadEgrulExtractButton_Click"/>

                                            <Button Grid.Column="3"
                                Content="Папка клиента"
                                Height="36"
                                FontSize="12"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenClientFilesFolderButton_Click"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- Быстрый обзор -->
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource NiatecSurfaceBrush}"
                        CornerRadius="14"
                        Padding="14"
                        BorderBrush="{StaticResource NiatecBorderBrush}"
                        BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="ЭЦП"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                            <TextBlock x:Name="OverviewSignatureTextBlock"
                                   Text="—"
                                   FontSize="13"
                                   Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1"
                        Background="{StaticResource NiatecSurfaceBrush}"
                        CornerRadius="14"
                        Padding="14"
                        BorderBrush="{StaticResource NiatecBorderBrush}"
                        BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Банковские счета"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                            <TextBlock x:Name="OverviewAccountsTextBlock"
                                   Text="—"
                                   FontSize="13"
                                   Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0"
                        Background="{StaticResource NiatecSurfaceBrush}"
                        CornerRadius="14"
                        Padding="14"
                        BorderBrush="{StaticResource NiatecBorderBrush}"
                        BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Заметки"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                            <TextBlock x:Name="OverviewNotesTextBlock"
                                   Text="—"
                                   FontSize="13"
                                   Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1"
                        Background="{StaticResource NiatecSurfaceBrush}"
                        CornerRadius="14"
                        Padding="14"
                        BorderBrush="{StaticResource NiatecBorderBrush}"
                        BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Документы"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                            <TextBlock x:Name="OverviewFilesTextBlock"
                                   Text="Откройте вкладку «Файлы» или папку клиента"
                                   FontSize="13"
                                   Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="{StaticResource NiatecSurfaceBrush}"
                        CornerRadius="14"
                        Padding="14"
                        BorderBrush="{StaticResource NiatecBorderBrush}"
                        BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Адрес"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                            <TextBlock x:Name="OverviewAddressTextBlock"
                                   Text="—"
                                   FontSize="13"
                                   Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource NiatecSurfaceAltBrush}"
                    CornerRadius="14"
                    Padding="12"
                    BorderBrush="{StaticResource NiatecBorderBrush}"
                    BorderThickness="1">
                                    <TextBlock Text="Для изменения данных клиента откройте вкладку «Карточка». Остальные рабочие данные доступны во вкладках ЭЦП, Банк, Заметки и Файлы."
                           FontSize="12"
                           Foreground="{StaticResource NiatecTextMutedBrush}"
                           TextWrapping="Wrap"/>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>
                    <TabViewItem x:Name="RequisitesTabViewItem" Header="Карточка" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="0">

                                <!-- Технические скрытые элементы для старого кода -->
                                <Border Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ClientHeaderTitleTextBlock"/>
                                        <TextBlock x:Name="ClientHeaderMetaTextBlock"/>
                                        <TextBlock x:Name="ClientHeaderBusinessTextBlock"/>
                                        <TextBlock x:Name="ClientHeaderSignatureTextBlock"/>
                                        <TextBlock x:Name="ClientHeaderStatusTextBlock"/>

                                        <TextBlock x:Name="SelectedStatusTextBlock"/>
                                        <TextBlock x:Name="SelectedTypeTextBlock"/>
                                        <TextBlock x:Name="SelectedNameTextBlock"/>
                                        <TextBlock x:Name="SelectedDirectorTextBlock"/>
                                        <TextBlock x:Name="SelectedInnTextBlock"/>
                                        <TextBlock x:Name="SelectedOgrnTextBlock"/>
                                        <TextBlock x:Name="SelectedAddressTextBlock"/>
                                        <TextBlock x:Name="SelectedSignatureCountTextBlock"/>
                                        <TextBlock x:Name="SelectedNearestSignatureTextBlock"/>
                                        <TextBlock x:Name="SelectedAccountCountTextBlock"/>
                                        <TextBlock x:Name="SelectedPrimaryBankTextBlock"/>
                                        <TextBlock x:Name="SelectedNoteCountTextBlock"/>
                                        <TextBlock x:Name="SelectedLatestNoteTextBlock"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource NiatecSurfaceBrush}"
                    CornerRadius="16"
                    Padding="16"
                    BorderBrush="{StaticResource NiatecBorderBrush}"
                    BorderThickness="1">

                                    <StackPanel Spacing="14">

                                        <!-- Заголовок формы -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Карточка клиента"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                                                <TextBlock x:Name="FormModeTextBlock"
                                       Text="Режим: добавление нового клиента"
                                       FontSize="12"
                                       Foreground="{StaticResource NiatecAccentBrush}"
                                       TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
        Content="Очистить форму"
        Height="34"
        FontSize="12"
        Visibility="Collapsed"
        Style="{StaticResource NiatecSecondaryButtonStyle}"
        Click="ClearFormButton_Click"/>
                                        </Grid>

                                        <!-- Тип / Категория / ОКВЭД -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="1.35*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="ClientTypeComboBox"
                                  Grid.Column="0"
                                  FontSize="13"
                                  Header="Тип клиента"
                                  SelectedIndex="0"
                                  SelectionChanged="ClientTypeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="ООО"/>
                                                <ComboBoxItem Content="ИП"/>
                                                <ComboBoxItem Content="ИПГКФХ"/>
                                                <ComboBoxItem Content="АНО"/>
                                            </ComboBox>

                                            <ComboBox x:Name="BusinessCategoryComboBox"
                                  Grid.Column="1"
                                  Header="Категория бизнеса"
                                  SelectedIndex="0">
                                                <ComboBoxItem Content="Не указано"/>
                                                <ComboBoxItem Content="Торговля"/>
                                                <ComboBoxItem Content="Перевозки / логистика"/>
                                                <ComboBoxItem Content="С/Х"/>
                                                <ComboBoxItem Content="IT / связь"/>
                                                <ComboBoxItem Content="Строительство"/>
                                                <ComboBoxItem Content="Производство"/>
                                                <ComboBoxItem Content="Гостиницы / общепит"/>
                                                <ComboBoxItem Content="Юр. / бух. / консалтинг"/>
                                                <ComboBoxItem Content="Недвижимость"/>
                                                <ComboBoxItem Content="Медицина / соцуслуги"/>
                                                <ComboBoxItem Content="Образование"/>
                                                <ComboBoxItem Content="Услуги населению"/>
                                                <ComboBoxItem Content="Прочее"/>
                                            </ComboBox>

                                            <TextBox x:Name="MainOkvedTextBox"
                                 Grid.Column="2"
                                 Header="Основной ОКВЭД"
                                 PlaceholderText="Например: 47.11"
                                 TextChanged="ClientFormField_TextChanged"/>
                                        </Grid>

                                        <!-- Скрытый статус, нужен старому коду -->
                                        <ComboBox x:Name="ClientStatusComboBox"
                              Header="Статус"
                              SelectedIndex="0"
                              Visibility="Collapsed">
                                            <ComboBoxItem Content="Активный"/>
                                            <ComboBoxItem Content="На продлении"/>
                                            <ComboBoxItem Content="Проблемный"/>
                                            <ComboBoxItem Content="Архив"/>
                                            <ComboBoxItem Content="Новый"/>
                                        </ComboBox>

                                        <!-- ИНН / По ИНН / ОГРН -->
                                        <Grid ColumnSpacing="12" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="1.8*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="InnTextBox"
                                 Grid.Column="0"
                                 FontSize="13"
                                 Header="ИНН"
                                 PlaceholderText="Введите ИНН"
                                 TextChanged="ClientFormField_TextChanged"/>

                                            <Button x:Name="FillByInnButton"
                                Grid.Column="1"
                                Content="По ИНН"
                                FontSize="12"
                                Height="34"
                                MinWidth="120"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="FillByInnButton_Click"/>

                                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="OgrnLabelTextBlock"
                                       Text="ОГРН"
                                       FontSize="12"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                                                <TextBox x:Name="OgrnTextBox"
                                     FontSize="13"
                                     PlaceholderText="Введите ОГРН"
                                     TextChanged="ClientFormField_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Название / Руководитель / Адрес -->
                                        <Border Background="{StaticResource NiatecSurfaceAltBrush}"
        CornerRadius="12"
        Padding="12"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="1">

                                            <StackPanel Spacing="12">

                                                <TextBlock Text="Основные данные"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                                                <Grid ColumnSpacing="12" RowSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Наименование организации / ФИО"
                           FontSize="12"
                           Foreground="{StaticResource NiatecTextSecondaryBrush}"/>

                                                        <TextBox x:Name="ClientNameTextBox"
                         FontSize="13"
                         PlaceholderText="ООО НИАТЕК / ИП Иванов И.И."
                         TextChanged="ClientFormField_TextChanged"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                        <TextBlock x:Name="DirectorLabelTextBlock"
                           Text="ФИО руководителя организации"
                           FontSize="12"
                           Foreground="{StaticResource NiatecTextSecondaryBrush}"/>

                                                        <TextBox x:Name="DirectorTextBox"
                         FontSize="13"
                         PlaceholderText="ФИО руководителя / ИП"
                         TextChanged="ClientFormField_TextChanged"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                                        <TextBlock Text="Юридический адрес"
                           FontSize="12"
                           Foreground="{StaticResource NiatecTextSecondaryBrush}"/>

                                                        <TextBox x:Name="AddressTextBox"
                         FontSize="13"
                         PlaceholderText="Введите юридический адрес"
                         TextWrapping="Wrap"
                         MinHeight="58"
                         TextChanged="ClientFormField_TextChanged"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="ClientFormValidationTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource NiatecAccentBrush}"
                               TextWrapping="Wrap"/>

                                        <!-- Действия -->
                                        <Border Background="{StaticResource NiatecSurfaceAltBrush}"
        CornerRadius="12"
        Padding="12"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="1">

                                            <StackPanel Spacing="10">

                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Действия"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                                                        <TextBlock Text="Сохранение, обновление и работа с карточкой клиента"
                           FontSize="11"
                           Foreground="{StaticResource NiatecTextMutedBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Основные действия -->
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.3*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button x:Name="SaveClientButton"
            Grid.Column="0"
            Content="Сохранить"
            FontSize="12"
            Height="36"
            Style="{StaticResource NiatecPrimaryButtonStyle}"
            Click="SaveClientButton_Click"/>

                                                    <Button Grid.Column="1"
            Content="Word"
            FontSize="12"
            Height="36"
            Style="{StaticResource NiatecSecondaryButtonStyle}"
            Click="ExportClientCardToWordButton_Click"/>

                                                    <Button Grid.Column="2"
            Content="Удалить"
            FontSize="12"
            Height="36"
            Style="{StaticResource NiatecDangerButtonStyle}"
            Click="DeleteSelectedClientButton_Click"/>

                                                    <!-- Техническая скрытая кнопка.
         Нужна старому коду, который может обращаться к UpdateSelectedClientButton. -->
                                                    <Button x:Name="UpdateSelectedClientButton"
            Visibility="Collapsed"
            Click="UpdateSelectedClientButton_Click"/>
                                                </Grid>

                                                <!-- Дополнительные действия -->
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.6*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                    Content="Скачать выписку"
                    FontSize="12"
                    Height="34"
                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                    Click="DownloadEgrulExtractButton_Click"/>

                                                    <Button Grid.Column="1"
                    Content="Открыть папку"
                    FontSize="12"
                    Height="34"
                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                    Click="OpenClientFilesFolderButton_Click"/>

                                                    <TextBlock Grid.Column="2"
                       Text="Word-экспорт и выписка сохраняются в документы клиента"
                       FontSize="11"
                       Foreground="{StaticResource NiatecTextMutedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="StatusTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource NiatecAccentBrush}"
                               TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="ЭЦП" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="0">
                                <!-- Краткая сводка по ЭЦП.
     Скрыта, чтобы не дублировать информацию из карточек ЭЦП и вкладки «Обзор». -->
                                <Border Visibility="Collapsed"
        Background="{StaticResource NiatecSurfaceBrush}"
        CornerRadius="14"
        Padding="14"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="1">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="5">
                                            <TextBlock Text="ЭЦП клиента"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                                            <TextBlock x:Name="SignatureTabSummaryTextBlock"
                       Text="Выберите клиента слева"
                       FontSize="13"
                       Foreground="{StaticResource NiatecTextSecondaryBrush}"
                       TextWrapping="Wrap"/>

                                            <TextBlock x:Name="SignatureTabNearestTextBlock"
                       Text="Ближайшая дата окончания: —"
                       FontSize="12"
                       Foreground="{StaticResource NiatecAccentBlueBrush}"
                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
        Visibility="Collapsed"
        Background="{StaticResource NiatecSurfaceAltBrush}"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="12,8"
        VerticalAlignment="Top">

                                            <TextBlock x:Name="SignatureTabStatusTextBlock"
                       Text="—"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource NiatecSurfaceBrush}"
                                    CornerRadius="14" Padding="12"
                                    BorderBrush="{StaticResource NiatecBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="ЭЦП выбранного клиента" FontSize="20" FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                        <ListView x:Name="SignaturesListView" Height="220"
                                            SelectionMode="Single" Background="Transparent" BorderThickness="0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:DigitalSignature">
                                                    <Border Background="{StaticResource NiatecSurfaceAltBrush}"
                BorderBrush="{StaticResource NiatecBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,8">

                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Spacing="5">
                                                                <TextBlock Text="{x:Bind AuthorityDisplayText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NiatecTextPrimaryBrush}"
                               TextWrapping="Wrap"/>

                                                                <TextBlock Text="{x:Bind DisplayText}"
                               FontSize="12"
                               Foreground="{StaticResource NiatecAccentBlueBrush}"/>

                                                                <TextBlock Text="{x:Bind CommentDisplayText}"
                               FontSize="12"
                               Foreground="{StaticResource NiatecTextMutedBrush}"
                               TextWrapping="Wrap"/>
                                                            </StackPanel>

                                                            <Border Grid.Column="1"
                        Background="{x:Bind StatusBackgroundBrush}"
                        CornerRadius="10"
                        Padding="10,6"
                        VerticalAlignment="Top">

                                                                <TextBlock Text="{x:Bind StatusText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{x:Bind StatusForegroundBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBox x:Name="SignatureAuthorityTextBox" Header="Удостоверяющий центр"
                                            PlaceholderText="Например: Контур / СБИС / Астрал"/>
                                        <TextBox x:Name="SignatureCommentTextBox" Header="Комментарий"
                                            PlaceholderText="Например: Отчетность / ЭДО / Госуслуги"/>
                                        <DatePicker x:Name="SignatureIssuedDatePicker" Header="ЭЦП получена"/>
                                        <DatePicker x:Name="SignatureExpiresDatePicker" Header="ЭЦП действует до"/>
                                        <Button Content="Добавить ЭЦП выбранному клиенту"
                                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                                            Click="AddSignatureButton_Click"/>
                                        <Button Content="Удалить выбранную ЭЦП"
                                            Style="{StaticResource NiatecDangerButtonStyle}"
                                            Click="DeleteSelectedSignatureButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="Банк" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="0">
                                <Border Background="{StaticResource NiatecSurfaceBrush}"
                                    CornerRadius="14" Padding="12"
                                    BorderBrush="{StaticResource NiatecBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <!-- Краткая сводка по банковским счетам.
     Скрыта, чтобы не дублировать информацию из карточек счетов. -->
                                        <Border Visibility="Collapsed"
        Background="{StaticResource NiatecSurfaceBrush}"
        CornerRadius="14"
        Padding="14"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="1">

                                            <StackPanel Spacing="5">
                                                <TextBlock Text="Банковские счета клиента"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                                                <TextBlock x:Name="BankTabSummaryTextBlock"
                   Text="Выберите клиента слева"
                   FontSize="13"
                   Foreground="{StaticResource NiatecTextSecondaryBrush}"
                   TextWrapping="Wrap"/>

                                                <TextBlock x:Name="BankTabPrimaryTextBlock"
                   Text="Основной банк: —"
                   FontSize="12"
                   Foreground="{StaticResource NiatecAccentBlueBrush}"
                   TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Банковские счета выбранного клиента" FontSize="20" FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                        <ListView x:Name="AccountsListView" Height="220"
                                            SelectionMode="Single" Background="Transparent" BorderThickness="0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:BankAccount">
                                                    <Border Background="{StaticResource NiatecSurfaceAltBrush}"
                BorderBrush="{StaticResource NiatecBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,8">

                                                        <StackPanel Spacing="8">

                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Spacing="4">
                                                                    <TextBlock Text="{x:Bind BankDisplayText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>

                                                                    <TextBlock Text="{x:Bind BicDisplayText}"
                                   FontSize="12"
                                   Foreground="{StaticResource NiatecAccentBlueBrush}"/>
                                                                </StackPanel>

                                                                <Border Grid.Column="1"
                            Background="{StaticResource NiatecSurfaceBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,6"
                            VerticalAlignment="Top">

                                                                    <TextBlock Text="Банковский счёт"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NiatecTextSecondaryBrush}"/>
                                                                </Border>
                                                            </Grid>

                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                            Background="{StaticResource NiatecSurfaceBrush}"
                            CornerRadius="10"
                            Padding="10,8">

                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="Расчётный счёт"
                                       FontSize="11"
                                       Foreground="{StaticResource NiatecTextMutedBrush}"/>

                                                                        <TextBlock Text="{x:Bind AccountDisplayText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <Border Grid.Column="1"
                            Background="{StaticResource NiatecSurfaceBrush}"
                            CornerRadius="10"
                            Padding="10,8">

                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="Корреспондентский счёт"
                                       FontSize="11"
                                       Foreground="{StaticResource NiatecTextMutedBrush}"/>

                                                                        <TextBlock Text="{x:Bind CorrespondentAccountDisplayText}"
                                       FontSize="12"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Text="{x:Bind CommentDisplayText}"
                           FontSize="12"
                           Foreground="{StaticResource NiatecTextMutedBrush}"
                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBox x:Name="BankBicTextBox" Header="БИК" PlaceholderText="Введите БИК"
                                            LostFocus="BankBicTextBox_LostFocus"/>
                                        <TextBox x:Name="BankNameTextBox" Header="Банк"
                                            PlaceholderText="Заполнится по БИК или введи вручную"/>
                                        <TextBox x:Name="BankCorrespondentAccountTextBox" Header="Корреспондентский счет"
                                            PlaceholderText="Заполнится по БИК"/>
                                        <TextBox x:Name="BankAccountNumberTextBox" Header="Расчетный счет"
                                            PlaceholderText="Введите расчетный счет"/>
                                        <TextBox x:Name="BankCommentTextBox" Header="Комментарий"
                                            PlaceholderText="Например: основной счет / резервный / зарплатный"/>
                                        <Button Content="Добавить счет выбранному клиенту"
                                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                                            Click="AddBankAccountButton_Click"/>
                                        <Button Content="Удалить выбранный счет"
                                            Style="{StaticResource NiatecDangerButtonStyle}"
                                            Click="DeleteSelectedBankAccountButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="Заметки" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="0">
                                <Border Background="{StaticResource NiatecSurfaceBrush}"
                                    CornerRadius="14" Padding="12"
                                    BorderBrush="{StaticResource NiatecBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Заметки выбранного клиента" FontSize="20" FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                        <ListView x:Name="NotesListView" Height="220"
                                            SelectionMode="Single" Background="Transparent" BorderThickness="0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ClientNote">
                                                    <Border Background="{StaticResource NiatecSurfaceAltBrush}"
                                                        CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind CreatedAtText}" FontSize="14" FontWeight="SemiBold"
                                                                Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                                            <TextBlock Text="{x:Bind NoteText}"
                                                                Foreground="{StaticResource NiatecTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBox x:Name="NoteTextBox" Header="Текст заметки"
                                            PlaceholderText="Например: позвонить клиенту, продлить ЭЦП, уточнить реквизиты"
                                            AcceptsReturn="True" TextWrapping="Wrap" Height="100"/>
                                        <CheckBox x:Name="NoteReminderCheckBox" Content="Добавить напоминание"
                                            Checked="NoteReminderCheckBox_Changed" Unchecked="NoteReminderCheckBox_Changed"/>
                                        <DatePicker x:Name="NoteReminderDatePicker" Header="Дата напоминания" Visibility="Collapsed"/>
                                        <Button Content="Добавить заметку выбранному клиенту"
                                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                                            Click="AddNoteButton_Click"/>
                                        <Button Content="Удалить выбранную заметку"
                                            Click="DeleteSelectedNoteButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="Файлы" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="0">
                                <Border Background="{StaticResource NiatecSurfaceBrush}"
                                    CornerRadius="14" Padding="12"
                                    BorderBrush="{StaticResource NiatecBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Файлы выбранного клиента" FontSize="20" FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                        <Grid ColumnSpacing="12" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="AddClientFileTopButtonHost" Grid.Row="0" Grid.Column="0" Background="Transparent">
                                                <Button x:Name="AddClientFileTopButton"
                                                    Style="{StaticResource NiatecPrimaryButtonStyle}"
                                                    Click="AddClientFileButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="Add"/>
                                                        <TextBlock Text="Прикрепить" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid x:Name="OpenSelectedClientFileTopButtonHost" Grid.Row="0" Grid.Column="1" Background="Transparent">
                                                <Button x:Name="OpenSelectedClientFileTopButton"
                                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                    Click="OpenSelectedClientFileButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="OpenFile"/>
                                                        <TextBlock Text="Открыть" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid x:Name="RevealSelectedClientFileTopButtonHost" Grid.Row="1" Grid.Column="0" Background="Transparent">
                                                <Button x:Name="RevealSelectedClientFileTopButton"
                                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                    Click="RevealSelectedClientFileButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="Folder"/>
                                                        <TextBlock Text="В папке" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid x:Name="OpenClientFilesFolderTopButtonHost" Grid.Row="1" Grid.Column="1" Background="Transparent">
                                                <Button x:Name="OpenClientFilesFolderTopButton"
                                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                    Click="OpenClientFilesFolderButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="Folder"/>
                                                        <TextBlock Text="Папка клиента" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid x:Name="ConvertSelectedClientFileToPdfTopButtonHost" Grid.Row="2" Grid.Column="0" Background="Transparent">
                                                <Button x:Name="ConvertSelectedClientFileToPdfTopButton"
                                                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                                                    Click="ConvertSelectedClientFileToPdfButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="Document"/>
                                                        <TextBlock Text="PDF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid x:Name="DeleteSelectedClientFileTopButtonHost" Grid.Row="2" Grid.Column="1" Background="Transparent">
                                                <Button x:Name="DeleteSelectedClientFileTopButton"
                                                    Style="{StaticResource NiatecDangerButtonStyle}"
                                                    Click="DeleteSelectedClientFileButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="Delete"/>
                                                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>

                                        <TextBlock Text="Предпросмотр выбранного файла" FontSize="18" FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                                        <TextBlock x:Name="FilePreviewStatusTextBlock"
                                            Text="Выбери файл для предпросмотра."
                                            Foreground="{StaticResource NiatecTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <Border Background="{StaticResource NiatecSurfaceAltBrush}"
                                            CornerRadius="12" Padding="8" Height="320">
                                            <Grid>
                                                <Image x:Name="FilePreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                                                <WebView2 x:Name="FilePreviewWebView" Visibility="Collapsed"/>
                                                <TextBox x:Name="FilePreviewTextBox" IsReadOnly="True"
                                                    AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed"/>
                                                <StackPanel x:Name="FilePreviewFallbackPanel" Visibility="Visible"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                    <TextBlock x:Name="FilePreviewFallbackTitleTextBlock"
                                                        Text="Предпросмотр недоступен"
                                                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                        FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="FilePreviewFallbackTextBlock"
                                                        Text="Для этого типа файла пока доступно открытие внешней программой."
                                                        Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                                        TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ComboBox x:Name="ClientFileFilterComboBox" Header="Фильтр файлов"
                                            SelectionChanged="ClientFileFilterComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Все файлы"/>
                                            <ComboBoxItem Content="Выписка"/>
                                            <ComboBoxItem Content="Требование"/>
                                            <ComboBoxItem Content="Договор"/>
                                            <ComboBoxItem Content="ЭЦП"/>
                                            <ComboBoxItem Content="Доверенность"/>
                                            <ComboBoxItem Content="Прочее"/>
                                            <ComboBoxItem Content="Акт"/>
                                            <ComboBoxItem Content="Счёт-фактура"/>
                                            <ComboBoxItem Content="Акт XML"/>
                                            <ComboBoxItem Content="Счёт-фактура XML"/>
                                        </ComboBox>
                                        <TextBox x:Name="ClientFileSearchTextBox" Header="Поиск по файлам"
                                            PlaceholderText="Поиск по имени файла или категории"
                                            TextChanged="ClientFileSearchTextBox_TextChanged"/>
                                        <Button Content="Очистить поиск файлов"
                                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                                            Click="ClearClientFileSearchButton_Click"/>
                                        <ListView x:Name="ClientFilesListView" Height="220"
                                            SelectionMode="Single"
                                            SelectionChanged="ClientFilesListView_SelectionChanged"
                                            Background="Transparent" BorderThickness="0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ClientFile">
                                                    <Border Background="{StaticResource NiatecSurfaceAltBrush}"
                                                        CornerRadius="12" Padding="12" Margin="0,0,0,10"
                                                        RightTapped="ClientFileCard_RightTapped"
                                                        DoubleTapped="ClientFileCard_DoubleTapped">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind OriginalFileName}"
                                                                FontSize="15" FontWeight="SemiBold"
                                                                Foreground="{StaticResource NiatecTextPrimaryBrush}" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border Background="#2F4F6F" CornerRadius="8" Padding="8,2">
                                                                    <TextBlock Text="{x:Bind FileTypeLabel}"
                                                                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                                        FontSize="12" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Text="{x:Bind Category}"
                                                                    Foreground="{StaticResource NiatecAccentBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind FileTypeDescription}"
                                                                Foreground="{StaticResource NiatecTextSecondaryBrush}"/>
                                                            <TextBlock Text="{x:Bind AddedAtText}"
                                                                Foreground="{StaticResource NiatecAccentBlueBrush}"/>
                                                            <TextBlock Text="{x:Bind FileSizeText}"
                                                                Foreground="{StaticResource NiatecTextMutedBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <ComboBox x:Name="ClientFileCategoryComboBox" Header="Категория файла" SelectedIndex="5">
                                            <ComboBoxItem Content="Выписка"/>
                                            <ComboBoxItem Content="Требование"/>
                                            <ComboBoxItem Content="Договор"/>
                                            <ComboBoxItem Content="ЭЦП"/>
                                            <ComboBoxItem Content="Доверенность"/>
                                            <ComboBoxItem Content="Прочее"/>
                                            <ComboBoxItem Content="Акт"/>
                                            <ComboBoxItem Content="Счёт-фактура"/>
                                            <ComboBoxItem Content="Акт XML"/>
                                            <ComboBoxItem Content="Счёт-фактура XML"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                </TabView>
            </Grid>
        </Grid>
    </Grid>
</Page>