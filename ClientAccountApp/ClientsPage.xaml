<Page
    x:Class="ClientAccountApp.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0F1115" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock
                Text="Клиенты"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="White"/>

            <TextBlock
                Text="Это новая страница версии 2. На этом шаге мы делаем новую оболочку приложения и сохраняем доступ к текущему рабочему экрану версии 1."
                TextWrapping="Wrap"
                Foreground="#B8B8B8"/>

            <Border
                Background="#171A21"
                CornerRadius="16"
                Padding="16"
                BorderBrush="#2B3140"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Текущий рабочий экран"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Нажми кнопку ниже, чтобы открыть текущую рабочую версию экрана клиентов из версии 1 в отдельном окне."
                        TextWrapping="Wrap"
                        Foreground="#B8B8B8"/>

                    <Button
                        Content="Открыть рабочий экран версии 1"
                        Click="OpenLegacyWorkspaceButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>