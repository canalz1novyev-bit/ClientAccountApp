<Page
    x:Class="ClientAccountApp.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Прозрачная кнопка-обёртка вокруг метрической карточки -->
        <Style x:Key="DashboardMetricButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Background="{StaticResource NiatecBackgroundBrush}"
            Padding="24"
            RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Сводка"
                        Style="{StaticResource NiatecPageTitleTextStyle}"/>

                    <TextBlock
                        x:Name="ActiveOrganizationTextBlock"
                        Text="Рабочая организация: —"
                        Style="{StaticResource NiatecPageSubtitleTextStyle}"/>

                    <TextBlock
                        x:Name="DashboardUpdatedAtTextBlock"
                        Text="Обновлено: —"
                        Style="{StaticResource NiatecMutedTextStyle}"/>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    x:Name="RefreshDashboardButton"
                    Content="Обновить"
                    Click="RefreshDashboardButton_Click"
                    VerticalAlignment="Top"
                    Style="{StaticResource NiatecSecondaryButtonStyle}"/>

                <ProgressRing
                    x:Name="DashboardProgressRing"
                    Grid.Column="1"
                    Width="20" Height="20"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    IsActive="False"
                    Visibility="Collapsed"
                    Foreground="{StaticResource NiatecAccentBrush}"/>
            </Grid>

            <!-- Карточки показателей -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Style="{StaticResource DashboardMetricButtonStyle}"
                    Click="OpenClientsButton_Click">
                    <Border Style="{StaticResource NiatecCardBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Клиенты"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                                x:Name="ClientsTotalTextBlock"
                                Text="0"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                            <TextBlock
                                Text="Всего в базе"
                                Style="{StaticResource NiatecMutedTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Button
                    Grid.Column="1"
                    Style="{StaticResource DashboardMetricButtonStyle}"
                    Click="OpenSignaturesButton_Click">
                    <Border Style="{StaticResource NiatecCardBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="ЭЦП"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                                x:Name="SignaturesAttentionTextBlock"
                                Text="0"
                                Style="{StaticResource NiatecMetricNumberTextStyle}"/>

                            <TextBlock
                                Text="Истекают или просрочены"
                                Style="{StaticResource NiatecMutedTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Button
                    Grid.Column="2"
                    Style="{StaticResource DashboardMetricButtonStyle}"
                    Click="OpenContractsButton_Click">
                    <Border Style="{StaticResource NiatecCardBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Договоры"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                                x:Name="ContractsWorkTextBlock"
                                Text="0"
                                Style="{StaticResource NiatecMetricNumberTextStyle}"/>

                            <TextBlock
                                Text="В работе по организации"
                                Style="{StaticResource NiatecMutedTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Button
                    Grid.Column="3"
                    Style="{StaticResource DashboardMetricButtonStyle}"
                    Click="OpenBillingButton_Click">
                    <Border Style="{StaticResource NiatecCardBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Начисления"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                                x:Name="UnpaidInvoicesTextBlock"
                                Text="0"
                                Style="{StaticResource NiatecMetricNumberTextStyle}"/>

                            <TextBlock
                                x:Name="UnpaidInvoicesAmountTextBlock"
                                Text="К оплате: 0,00 ₽"
                                Style="{StaticResource NiatecMutedTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- Аналитика по категориям бизнеса -->
            <Border Grid.Row="2" Style="{StaticResource NiatecCardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Клиенты по категориям"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                            <TextBlock
                                Text="Распределение клиентской базы по основному виду деятельности"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>
                        </StackPanel>

                        <TextBlock
                            x:Name="CategoryAnalyticsTotalTextBlock"
                            Grid.Column="1"
                            Text="Всего: 0"
                            Foreground="{StaticResource NiatecAccentBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel
                        x:Name="CategoryAnalyticsPanel"
                        Spacing="8"/>
                </StackPanel>
            </Border>

            <!-- Нижний рабочий блок -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Требует внимания"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                        <StackPanel
                            x:Name="AttentionPanel"
                            Spacing="10"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Последние события"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                        <StackPanel
                            x:Name="RecentPanel"
                            Spacing="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>