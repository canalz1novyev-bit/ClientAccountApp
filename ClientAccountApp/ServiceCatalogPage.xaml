<Page
    x:Class="ClientAccountApp.ServiceCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NiatecBackgroundBrush}" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="Справочник услуг"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
            <TextBlock
                Text="Типовые услуги для быстрого добавления в счета"
                FontSize="12"
                Foreground="{StaticResource NiatecTextSecondaryBrush}"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Список услуг -->
            <Border
                Grid.Column="0"
                Background="{StaticResource NiatecSurfaceBrush}"
                BorderBrush="{StaticResource NiatecBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12">

                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="Услуги"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                            <TextBlock
                                x:Name="CatalogCountTextBlock"
                                Text="Загрузка..."
                                FontSize="12"
                                Foreground="{StaticResource NiatecTextMutedBrush}"/>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="+ Новая услуга"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            Click="NewServiceButton_Click"/>
                    </Grid>

                    <ListView
                        x:Name="CatalogListView"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Single"
                        SelectionChanged="CatalogListView_SelectionChanged"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{StaticResource NiatecSurfaceAltBrush}"
                                    BorderBrush="{StaticResource NiatecBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="{Binding Unit}"
                                                    FontSize="12"
                                                    Foreground="{StaticResource NiatecTextMutedBrush}"/>
                                                <TextBlock
                                                    Text="·"
                                                    FontSize="12"
                                                    Foreground="{StaticResource NiatecTextMutedBrush}"/>
                                                <TextBlock
                                                    x:Name="VatLabel"
                                                    Text="{Binding VatText}"
                                                    FontSize="12"
                                                    Foreground="{StaticResource NiatecTextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding PriceText}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecAccentBrush}"
                                            VerticalAlignment="Center"/>

                                        <Button
                                            Grid.Column="2"
                                            Content="✎"
                                            FontSize="14"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Tag="{Binding Id}"
                                            Click="EditServiceButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Редактор -->
            <Border
                Grid.Column="1"
                Background="{StaticResource NiatecSurfaceBrush}"
                BorderBrush="{StaticResource NiatecBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок редактора -->
                    <Border
                        Background="{StaticResource NiatecSurfaceAltBrush}"
                        BorderBrush="{StaticResource NiatecBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="EditorTitleTextBlock"
                                Text="Новая услуга"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                            <TextBlock
                                x:Name="EditorHintTextBlock"
                                Text="Заполни поля и нажми «Сохранить»"
                                FontSize="12"
                                Foreground="{StaticResource NiatecTextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Padding="0,4,0,0">

                            <TextBox
                                x:Name="ServiceNameTextBox"
                                Header="Название услуги"
                                PlaceholderText="Например: Абонентское обслуживание"/>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="ServicePriceTextBox"
                                    Grid.Column="0"
                                    Header="Цена по умолчанию (₽)"
                                    PlaceholderText="0"/>

                                <TextBox
                                    x:Name="ServiceUnitTextBox"
                                    Grid.Column="1"
                                    Header="Ед. изм."
                                    Text="усл."/>
                            </Grid>

                            <TextBox
                                x:Name="ServiceVatRateTextBox"
                                Header="Ставка НДС (%)"
                                PlaceholderText="0"/>

                            <TextBox
                                x:Name="ServiceCommentTextBox"
                                Header="Комментарий (необязательно)"
                                PlaceholderText="Описание услуги"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="80"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="SaveServiceButton"
                                Grid.Column="0"
                                Content="Сохранить"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="SaveServiceButton_Click"/>

                            <Button
                                x:Name="DeleteServiceButton"
                                Grid.Column="1"
                                Content="Удалить"
                                IsEnabled="False"
                                Style="{StaticResource NiatecDangerButtonStyle}"
                                Click="DeleteServiceButton_Click"/>
                        </Grid>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                            <TextBlock
                                x:Name="CatalogStatusTextBlock"
                                Text="Выбери услугу из списка или создай новую."
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
