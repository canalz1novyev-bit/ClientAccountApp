<Page
    x:Class="ClientAccountApp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NiatecBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Параметры" Style="{StaticResource NiatecPageTitleTextStyle}"/>
            <TextBlock
                Text="Хранилище данных и резервные копии."
                Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            <TextBlock
                x:Name="StoragePathInfoTextBlock"
                Text="Загрузка..."
                Style="{StaticResource NiatecMutedTextStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Хранилище данных -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20"
                                      Foreground="{StaticResource NiatecAccentBrush}"/>
                            <TextBlock Text="Хранилище данных"
                                       Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            x:Name="StorageCurrentPathTextBlock"
                            Text="Определение пути..."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Content="Открыть папку"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="OpenStorageFolderButton_Click"/>
                            <Button
                                Grid.Column="1"
                                Content="Изменить папку"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenStorageSettingsButton_Click"/>
                            <Button
                                x:Name="ResetStorageButton"
                                Grid.Column="2"
                                Content="Сбросить на стандартный"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="ResetStorageButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Резервные копии -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="20"
                                      Foreground="{StaticResource NiatecAccentBrush}"/>
                            <TextBlock Text="Резервные копии"
                                       Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            Text="Копируют базу данных и файлы клиентов в папку Backups. Делайте копию перед важными изменениями — это займёт несколько секунд."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="CreateBackupButton"
                                Grid.Column="0"
                                Content="Создать резервную копию"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="CreateBackupButton_Click"/>

                            <Button
                                Grid.Column="1"
                                Content="Открыть папку копий"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenBackupsFolderButton_Click"/>

                            <Button
                                Grid.Column="2"
                                Content="Все резервные копии"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenBackupsButton_Click"/>
                        </Grid>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <TextBlock
                                x:Name="BackupStatusTextBlock"
                                Text="Резервные копии хранятся в папке Backups внутри хранилища данных."
                                Style="{StaticResource NiatecCaptionTextStyle}"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>