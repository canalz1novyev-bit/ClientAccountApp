<Page
    x:Class="ClientAccountApp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NiatecBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="Параметры"
                Style="{StaticResource NiatecPageTitleTextStyle}"/>

            <TextBlock
                Text="Настройки внешнего вида, данных приложения, совместной работы и резервных копий."
                Style="{StaticResource NiatecPageSubtitleTextStyle}"/>

            <TextBlock
                x:Name="StoragePathInfoTextBlock"
                Text="Загрузка сведений..."
                Style="{StaticResource NiatecMutedTextStyle}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1250">

                <!-- Внешний вид -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE790;"
                                FontSize="20"
                                Foreground="{StaticResource NiatecAccentBrush}"/>

                            <TextBlock
                                Text="Внешний вид"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            Text="Выберите тему оформления приложения. Изменение применяется сразу."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">

                            <Border
                                x:Name="DarkThemeCard"
                                Width="160"
                                Height="90"
                                CornerRadius="12"
                                Background="#0B0F17"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="2"
                                Padding="12"
                                Tag="Dark"
                                Tapped="ThemePreviewCard_Tapped">

                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Тёмная"
                                        Foreground="White"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Классический тёмный интерфейс"
                                        Foreground="#9AA7BD"
                                        FontSize="11"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="LightThemeCard"
                                Width="160"
                                Height="90"
                                CornerRadius="12"
                                Background="#F0F2F5"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="2"
                                Padding="12"
                                Tag="Light"
                                Tapped="ThemePreviewCard_Tapped">

                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Светлая"
                                        Foreground="#1A2033"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Светлый интерфейс для работы днём"
                                        Foreground="#4A5568"
                                        FontSize="11"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="MilitaryThemeCard"
                                Width="160"
                                Height="90"
                                CornerRadius="12"
                                BorderBrush="{StaticResource NiatecBorderBrush}"
                                BorderThickness="2"
                                Padding="12"
                                Tag="Military"
                                Tapped="ThemePreviewCard_Tapped">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B4A2A" Offset="0"/>
                                        <GradientStop Color="#2A3D1A" Offset="0.5"/>
                                        <GradientStop Color="#1E1A0E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="M81 Woodland"
                                        Foreground="#B8D478"
                                        FontSize="13"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Камуфляжная тема"
                                        Foreground="#6A7A40"
                                        FontSize="11"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock
                            x:Name="ThemeStatusTextBlock"
                            Text=""
                            Foreground="{StaticResource NiatecAccentBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Данные приложения -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE8B7;"
                                FontSize="20"
                                Foreground="{StaticResource NiatecAccentBrush}"/>

                            <TextBlock
                                Text="Данные приложения"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            x:Name="DataModeTextBlock"
                            Text="Текущий режим: Локальный"
                            FontWeight="SemiBold"
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            x:Name="StorageHelpTextBlock"
                            Text="Здесь хранятся база приложения, файлы клиентов, документы и резервные копии."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Папка данных:"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NiatecCaptionTextStyle}"/>

                                <TextBlock
                                    x:Name="StorageCurrentPathTextBlock"
                                    Text="Определение пути..."
                                    Style="{StaticResource NiatecCaptionTextStyle}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Открыть папку данных"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="OpenStorageFolderButton_Click"/>

                            <Button
                                Content="Изменить папку"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenStorageSettingsButton_Click"/>

                            <Button
                                x:Name="ResetStorageButton"
                                Content="Сбросить на стандартную"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="ResetStorageButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Совместная работа -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE902;"
                                FontSize="20"
                                Foreground="{StaticResource NiatecAccentBrush}"/>

                            <TextBlock
                                Text="Совместная работа"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            x:Name="SqlServerModeTextBlock"
                            Text="Сейчас приложение работает в локальном режиме."
                            FontWeight="SemiBold"
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            x:Name="SharedWorkDescriptionTextBlock"
                            Text="Этот режим подходит, если с программой работает один пользователь на одном компьютере. Если нужно, чтобы несколько сотрудников работали с одной базой, настройте совместную работу."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">

                            <TextBlock
                                x:Name="SharedWorkDetailsTextBlock"
                                Text="Сервер не используется. Все данные хранятся на этом компьютере."
                                Style="{StaticResource NiatecCaptionTextStyle}"
                                TextWrapping="Wrap"/>
                        </Border>

                        <Button
                            Content="Настроить совместную работу"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OpenDatabaseConnectionButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Резервные копии -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE896;"
                                FontSize="20"
                                Foreground="{StaticResource NiatecAccentBrush}"/>

                            <TextBlock
                                Text="Резервные копии"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            Text="Создавайте резервную копию перед важными изменениями. Она поможет восстановить клиентов, документы и файлы, если что-то пойдёт не так."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CreateBackupButton"
                                Content="Создать резервную копию"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="CreateBackupButton_Click"/>

                            <Button
                                Content="Открыть папку копий"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenBackupsFolderButton_Click"/>

                            <Button
                                Content="Все резервные копии"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenBackupsButton_Click"/>
                        </StackPanel>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">

                            <TextBlock
                                x:Name="BackupStatusTextBlock"
                                Text="Резервные копии сохраняются внутри папки данных приложения."
                                Style="{StaticResource NiatecCaptionTextStyle}"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Внешние сервисы (API-ключи) -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE71D;"
                                FontSize="20"
                                Foreground="{StaticResource NiatecAccentBrush}"/>

                            <TextBlock
                                Text="Внешние сервисы"
                                Style="{StaticResource NiatecSectionTitleTextStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            Text="API-ключи для автозаполнения по ИНН, поиска банка по БИК и проверки контрагентов. Ключи хранятся в защищённом Windows Credential Vault."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <PasswordBox
                            x:Name="DaDataApiKeySettingsBox"
                            Header="API-ключ DaData"
                            PlaceholderText="Вставьте ваш ключ DaData"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Сохранить ключ DaData"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="SaveDaDataKeyFromSettings_Click"/>

                            <Button
                                Content="Удалить ключ"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="ClearDaDataKeyFromSettings_Click"/>
                        </StackPanel>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">

                            <TextBlock
                                x:Name="DaDataKeySettingsStatusTextBlock"
                                Text=""
                                Style="{StaticResource NiatecCaptionTextStyle}"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>