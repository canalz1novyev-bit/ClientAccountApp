<Page
    x:Class="ClientAccountApp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NiatecBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Параметры" Style="{StaticResource NiatecPageTitleTextStyle}"/>
            <TextBlock
                Text="Хранилище данных, резервные копии и внешний вид."
                Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            <TextBlock
                x:Name="StoragePathInfoTextBlock"
                Text="Загрузка..."
                Style="{StaticResource NiatecMutedTextStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Внешний вид -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE790;" FontSize="20"
                                      Foreground="{StaticResource NiatecAccentBrush}"/>
                            <TextBlock Text="Внешний вид"
                                       Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            Text="Выберите тёмную или светлую тему. Изменение применяется немедленно."
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="DarkThemeCard"
                                    Width="160" Height="90" CornerRadius="12"
                                    Background="#0B0F17"
                                    BorderBrush="{StaticResource NiatecBorderBrush}"
                                    BorderThickness="2" Padding="12"
                                    Tapped="DarkThemeCard_Tapped">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Тёмная" Foreground="White"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Классический тёмный интерфейс"
                                               Foreground="#9AA7BD" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="LightThemeCard"
                                    Width="160" Height="90" CornerRadius="12"
                                    Background="#F0F2F5"
                                    BorderBrush="{StaticResource NiatecBorderBrush}"
                                    BorderThickness="2" Padding="12"
                                    Tapped="LightThemeCard_Tapped">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Светлая" Foreground="#1A2033"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Светлый интерфейс для работы днём"
                                               Foreground="#4A5568" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MilitaryThemeCard"
        Width="160" Height="90" CornerRadius="12"
        BorderBrush="{StaticResource NiatecBorderBrush}"
        BorderThickness="2" Padding="12"
        Tapped="MilitaryThemeCard_Tapped">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B4A2A" Offset="0"/>
                                        <GradientStop Color="#2A3D1A" Offset="0.5"/>
                                        <GradientStop Color="#1E1A0E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="М81 Woodland" Foreground="#B8D478"
                   FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Камуфляж · военная тема"
                   Foreground="#6A7A40" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock
                            x:Name="ThemeStatusTextBlock"
                            Text=""
                            Foreground="{StaticResource NiatecAccentBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Хранилище данных -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20"
                                      Foreground="{StaticResource NiatecAccentBrush}"/>
                            <TextBlock Text="Хранилище данных"
                                       Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            x:Name="StorageCurrentPathTextBlock"
                            Text="Определение пути..."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Content="Открыть папку"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="OpenStorageFolderButton_Click"/>
                            <Button
                                Grid.Column="1"
                                Content="Изменить папку"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenStorageSettingsButton_Click"/>
                            <Button
                                x:Name="ResetStorageButton"
                                Grid.Column="2"
                                Content="Сбросить на стандартный"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="ResetStorageButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Корпоративная база -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xF259;" FontSize="20"
                                      Foreground="{StaticResource NiatecAccentBrush}"/>
                            <TextBlock Text="Корпоративная база данных"
                                       Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            x:Name="SqlServerModeTextBlock"
                            Text="Режим: Локальная SQLite"
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <TextBlock
                            Text="SQL Server позволяет нескольким сотрудникам работать с одной базой данных одновременно."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Button
                            Content="Открыть настройки подключения"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OpenDatabaseConnectionButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Резервные копии -->
                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="20"
                                      Foreground="{StaticResource NiatecAccentBrush}"/>
                            <TextBlock Text="Резервные копии"
                                       Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock
                            Text="Копируют базу данных и файлы клиентов в папку Backups. Делайте копию перед важными изменениями."
                            Style="{StaticResource NiatecCaptionTextStyle}"
                            TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="CreateBackupButton"
                                Grid.Column="0"
                                Content="Создать резервную копию"
                                Style="{StaticResource NiatecPrimaryButtonStyle}"
                                Click="CreateBackupButton_Click"/>

                            <Button
                                Grid.Column="1"
                                Content="Открыть папку копий"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenBackupsFolderButton_Click"/>

                            <Button
                                Grid.Column="2"
                                Content="Все резервные копии"
                                Style="{StaticResource NiatecSecondaryButtonStyle}"
                                Click="OpenBackupsButton_Click"/>
                        </Grid>

                        <Border
                            Background="{StaticResource NiatecSurfaceAltBrush}"
                            BorderBrush="{StaticResource NiatecBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <TextBlock
                                x:Name="BackupStatusTextBlock"
                                Text="Резервные копии хранятся в папке Backups внутри хранилища данных."
                                Style="{StaticResource NiatecCaptionTextStyle}"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>