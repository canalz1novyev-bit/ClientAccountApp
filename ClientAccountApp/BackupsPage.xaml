<Page
    x:Class="ClientAccountApp.BackupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border
            Background="{StaticResource NiatecBackgroundBrush}"
            Padding="16">

            <StackPanel Spacing="18">

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Резервные копии"
                        Style="{StaticResource NiatecPageTitleTextStyle}"/>

                    <TextBlock
                        Text="Создание и контроль резервных копий базы данных и файлов клиентов."
                        Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
                </StackPanel>

                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="Папка резервных копий"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                        <TextBlock
                            x:Name="BackupFolderPathTextBlock"
                            TextWrapping="Wrap"
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <TextBlock
                            x:Name="BackupStatusTextBlock"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource NiatecAccentBrush}"/>

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="Действия"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                        <StackPanel
    Orientation="Horizontal"
    Spacing="10">

                            <Button
        Content="Создать резервную копию"
        Style="{StaticResource NiatecPrimaryButtonStyle}"
        Click="CreateBackupButton_Click"/>

                            <Button
        Content="Восстановить последнюю резервную копию"
        Style="{StaticResource NiatecSecondaryButtonStyle}"
        Click="RestoreLatestBackupButton_Click"/>

                            <Button
        Content="Открыть папку резервных копий"
        Style="{StaticResource NiatecSecondaryButtonStyle}"
        Click="OpenBackupsFolderButton_Click"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NiatecCardBorderStyle}">
                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="Старое рабочее пространство"
                            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                        <TextBlock
                            Text="Переход к старому рабочему экрану оставлен для технического контроля."
                            Style="{StaticResource NiatecCaptionTextStyle}"/>

                        <Button
                            Content="Открыть старое рабочее пространство"
                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OpenLegacyWorkspaceButton_Click"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>