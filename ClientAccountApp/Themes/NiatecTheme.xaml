<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================
         BRUSHES / COLORS
         ========================= -->

    <Color x:Key="NiatecBackgroundColor">#0B0F17</Color>
    <Color x:Key="NiatecSurfaceColor">#121826</Color>
    <Color x:Key="NiatecSurfaceAltColor">#161F2E</Color>
    <Color x:Key="NiatecBorderColor">#2A3548</Color>

    <Color x:Key="NiatecTextPrimaryColor">#F3F5F7</Color>
    <Color x:Key="NiatecTextSecondaryColor">#9AA7BD</Color>
    <Color x:Key="NiatecTextMutedColor">#6F7C91</Color>

    <Color x:Key="NiatecAccentColor">#D4A85F</Color>
    <Color x:Key="NiatecAccentBlueColor">#4C7EDB</Color>

    <Color x:Key="NiatecSuccessColor">#4FA36B</Color>
    <Color x:Key="NiatecWarningColor">#D6A14A</Color>
    <Color x:Key="NiatecDangerColor">#C65B5B</Color>
    <Color x:Key="NiatecInfoColor">#5C8DFF</Color>

    <SolidColorBrush x:Key="NiatecBackgroundBrush" Color="{StaticResource NiatecBackgroundColor}"/>
    <SolidColorBrush x:Key="NiatecSurfaceBrush" Color="{StaticResource NiatecSurfaceColor}"/>
    <SolidColorBrush x:Key="NiatecSurfaceAltBrush" Color="{StaticResource NiatecSurfaceAltColor}"/>
    <SolidColorBrush x:Key="NiatecBorderBrush" Color="{StaticResource NiatecBorderColor}"/>

    <SolidColorBrush x:Key="NiatecTextPrimaryBrush" Color="{StaticResource NiatecTextPrimaryColor}"/>
    <SolidColorBrush x:Key="NiatecTextSecondaryBrush" Color="{StaticResource NiatecTextSecondaryColor}"/>
    <SolidColorBrush x:Key="NiatecTextMutedBrush" Color="{StaticResource NiatecTextMutedColor}"/>

    <SolidColorBrush x:Key="NiatecAccentBrush" Color="{StaticResource NiatecAccentColor}"/>
    <SolidColorBrush x:Key="NiatecAccentBlueBrush" Color="{StaticResource NiatecAccentBlueColor}"/>

    <SolidColorBrush x:Key="NiatecSuccessBrush" Color="{StaticResource NiatecSuccessColor}"/>
    <SolidColorBrush x:Key="NiatecWarningBrush" Color="{StaticResource NiatecWarningColor}"/>
    <SolidColorBrush x:Key="NiatecDangerBrush" Color="{StaticResource NiatecDangerColor}"/>
    <SolidColorBrush x:Key="NiatecInfoBrush" Color="{StaticResource NiatecInfoColor}"/>

    <!-- =========================
         COMMON SIZES
         ========================= -->

    <CornerRadius x:Key="NiatecCardCornerRadius">14</CornerRadius>
    <Thickness x:Key="NiatecCardBorderThickness">1</Thickness>
    <Thickness x:Key="NiatecCardPadding">16</Thickness>

    <!-- =========================
         TEXT STYLES
         ========================= -->

    <!-- Текст -->
    <Style x:Key="NiatecPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="NiatecPageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="NiatecSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="NiatecCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="NiatecMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecTextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="NiatecMetricNumberTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecAccentBrush}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    

    <!-- =========================
         CARD / PANEL
         ========================= -->

    <Style x:Key="NiatecCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NiatecSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource NiatecCardBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource NiatecCardCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource NiatecCardPadding}"/>
    </Style>

    <Style x:Key="NiatecInnerPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NiatecSurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- =========================
     BUTTONS
     ========================= -->

    <!-- Базовая кнопка NIATEC.Client.
     Все остальные кнопки наследуются от неё. -->
    <Style x:Key="NiatecBaseButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource DefaultButtonStyle}">

        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Главная кнопка: сохранить, создать, перенести, сформировать -->
    <Style x:Key="NiatecPrimaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource NiatecBaseButtonStyle}">

        <Setter Property="Background" Value="{StaticResource NiatecAccentBrush}"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecAccentBrush}"/>
    </Style>

    <!-- Обычная вторичная кнопка: открыть, выбрать, перейти -->
    <Style x:Key="NiatecSecondaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource NiatecBaseButtonStyle}">

        <Setter Property="Background" Value="{StaticResource NiatecSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NiatecTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecBorderBrush}"/>
    </Style>

    <!-- Опасная кнопка: удалить, сбросить, восстановить -->
    <Style x:Key="NiatecDangerButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource NiatecBaseButtonStyle}">

        <Setter Property="Background" Value="{StaticResource NiatecDangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecDangerBrush}"/>
    </Style>

    <!-- Маленькая кнопка-иконка, например переключение компактного вида -->
    <Style x:Key="NiatecSmallIconButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource NiatecBaseButtonStyle}">

        <Setter Property="Background" Value="{StaticResource NiatecSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NiatecTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecBorderBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <!-- Акцентная информационная строка -->
    <Style x:Key="NiatecAccentInfoTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecAccentBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Заголовок маленького шага внутри карточки -->
    <Style x:Key="NiatecStepTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NiatecAccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Крупное значение результата -->
    <Style x:Key="NiatecResultValueTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource NiatecAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource NiatecBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NiatecBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>