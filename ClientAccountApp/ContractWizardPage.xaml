<Page
    x:Class="ClientAccountApp.ContractWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NiatecBackgroundBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Мастер договоров"
                       Style="{StaticResource NiatecPageTitleTextStyle}"/>
            <TextBlock Text="Составляйте договоры из шаблонов с автозаполнением из базы клиентов. После создания можно сразу оформить УПД или счёт."
                       Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
        </StackPanel>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="380,*" ColumnSpacing="20">

                <!-- Левая панель: запуск мастера + последние договоры -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- Кнопка запуска -->
                    <Border Style="{StaticResource NiatecCardBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       Text="Создать договор"/>
                            <TextBlock Style="{StaticResource NiatecCaptionTextStyle}"
                                       Text="Откроется пошаговый мастер: выберите тип, укажите стороны, условия — и договор готов."/>

                            <!-- Типы договоров как компактная подсказка -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="6" Padding="8,6"
                                        Background="{StaticResource NiatecSurfaceAltBrush}">
                                    <TextBlock Text="Оказание услуг" FontSize="11"
                                               Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" CornerRadius="6" Padding="8,6"
                                        Background="{StaticResource NiatecSurfaceAltBrush}">
                                    <TextBlock Text="Поставка" FontSize="11"
                                               Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" CornerRadius="6" Padding="8,6"
                                        Background="{StaticResource NiatecSurfaceAltBrush}">
                                    <TextBlock Text="Аренда" FontSize="11"
                                               Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" CornerRadius="6" Padding="8,6"
                                        Background="{StaticResource NiatecSurfaceAltBrush}">
                                    <TextBlock Text="Подряд" FontSize="11"
                                               Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" CornerRadius="6" Padding="8,6"
                                        Background="{StaticResource NiatecSurfaceAltBrush}">
                                    <TextBlock Text="Агентский" FontSize="11"
                                               Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" CornerRadius="6" Padding="8,6"
                                        Background="{StaticResource NiatecSurfaceAltBrush}">
                                    <TextBlock Text="НДА" FontSize="11"
                                               Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Button x:Name="StartWizardButton"
                                    Content="Создать договор →"
                                    Style="{StaticResource NiatecPrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="StartWizardButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Статус последней операции -->
                    <Border x:Name="LastResultCard" Visibility="Collapsed"
                            Style="{StaticResource NiatecCardBorderStyle}"
                            BorderBrush="{StaticResource NiatecSuccessBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Договор создан" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource NiatecSuccessBrush}"/>
                            <TextBlock x:Name="LastResultText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="OpenLastFileButton"
                                        Content="Открыть файл"
                                        Style="{StaticResource NiatecSecondaryButtonStyle}"
                                        Click="OpenLastFileButton_Click"/>
                                <Button x:Name="GoToContractsButton"
                                        Content="В договоры"
                                        Style="{StaticResource NiatecSecondaryButtonStyle}"
                                        Click="GoToContractsButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Правая панель: последние созданные договоры -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource NiatecCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource NiatecSectionTitleTextStyle}"
                                       Text="Последние договоры"/>
                            <TextBlock Style="{StaticResource NiatecCaptionTextStyle}"
                                       Text="Договоры, сформированные через мастер"/>

                            <ListView x:Name="RecentContractsList"
                                      SelectionMode="Single"
                                      DoubleTapped="RecentContractsList_DoubleTapped">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding ClientName}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContractTypeName}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource NiatecAccentBrush}"/>
                                                <TextBlock Text="{Binding ContractNumber}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource NiatecTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DateDisplay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource NiatecTextMutedBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Text="двойной клик — открыть"
                                                           FontSize="10" Opacity="0.4"
                                                           Foreground="{StaticResource NiatecTextMutedBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="NoRecentContractsText"
                                       Text="Договоры, созданные через мастер, появятся здесь"
                                       FontSize="12"
                                       Foreground="{StaticResource NiatecTextMutedBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
