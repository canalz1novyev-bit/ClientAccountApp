<Page
    x:Class="ClientAccountApp.DataStorageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Background="{StaticResource NiatecBackgroundBrush}"
            Padding="24"
            RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="Хранилище данных"
                    Style="{StaticResource NiatecPageTitleTextStyle}"/>

                <TextBlock
                    Text="Настройка папки, где хранится база данных, файлы клиентов и резервные копии."
                    Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            </StackPanel>

            <!-- Текущее хранилище -->
            <Border
                Grid.Row="1"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Текущее хранилище"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock
                        x:Name="StorageModeTextBlock"
                        Text="Режим хранения"
                        Foreground="{StaticResource NiatecAccentBrush}"
                        FontSize="13"
                        TextWrapping="Wrap"/>

                    <TextBox
                        x:Name="CurrentStorageRootTextBox"
                        Header="Текущая папка"
                        IsReadOnly="True"/>

                    <TextBox
                        x:Name="DefaultStorageRootTextBox"
                        Header="Локальная папка приложения"
                        IsReadOnly="True"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Открыть текущую папку"
                            Click="OpenCurrentStorageButton_Click"/>

                        <Button
                            Content="Открыть файл настройки"
                            Click="OpenStorageSettingsFileButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Подключение другой папки -->
            <Border
                Grid.Row="2"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Подключить другую папку хранения"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock
                        Text="Укажи папку на компьютере или сетевом диске. Внутри неё программа будет хранить clients.db, ClientFiles и Backups."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                    <TextBox
                        x:Name="NewStorageRootTextBox"
                        Header="Новая папка хранения"
                        PlaceholderText="Например: D:\NIATEC\ClientBase или \\SERVER\ClientBase"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
    Content="Выбрать папку..."
    Style="{StaticResource NiatecSecondaryButtonStyle}"
    Click="PickStorageFolderButton_Click"/>

                        <Button
    Content="Сохранить новую папку"
    Style="{StaticResource NiatecPrimaryButtonStyle}"
    Click="SaveNewStorageRootButton_Click"/>

                        <Button
    Content="Перенести текущую базу и файлы"
    Style="{StaticResource NiatecPrimaryButtonStyle}"
    Click="CopyCurrentStorageToNewRootButton_Click"/>

                        <Button
    Content="Вернуться к локальному хранилищу"
    Style="{StaticResource NiatecDangerButtonStyle}"
    Click="ResetToLocalStorageButton_Click"/>
                    </StackPanel>

                    <TextBlock
                        x:Name="StorageStatusTextBlock"
                        Text=""
                        Foreground="{StaticResource NiatecAccentBrush}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Важно -->
            <Border
                Grid.Row="3"
                Style="{StaticResource NiatecInnerPanelBorderStyle}">

                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Важно"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock
                        Text="После смены папки хранения нужно перезапустить приложение. Если в новой папке ещё нет базы clients.db, приложение создаст новую пустую базу. Для сохранения текущих данных используй кнопку «Перенести текущую базу и файлы»."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>