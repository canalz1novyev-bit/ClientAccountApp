<Page
    x:Class="ClientAccountApp.DatabaseConnectionSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Background="{StaticResource NiatecBackgroundBrush}"
            Padding="16"
            RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="Корпоративная база"
                    Style="{StaticResource NiatecPageTitleTextStyle}"/>

                <TextBlock
                    Text="Настройка подключения к SQL Server для одновременной работы нескольких пользователей."
                    Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            </StackPanel>
            <Border
    Grid.Row="1"
    Grid.Column="1"
    Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="12">
                    <TextBlock
            Text="Диагностика базы"
            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock
            Text="Проверка текущего режима базы, подключения, таблиц и файлов клиентов."
            Style="{StaticResource NiatecCaptionTextStyle}"/>

                    <Button
            Content="Открыть диагностику"
            Style="{StaticResource NiatecSecondaryButtonStyle}"
            HorizontalAlignment="Left"
            Click="OpenDatabaseDiagnosticsButton_Click"/>
                </StackPanel>
            </Border>
            <Border
    Grid.Row="1"
    Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="14">
                    <TextBlock
            Text="Текущий режим и подключение"
            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                    x:Name="CurrentDatabaseModeTextBlock"
                    Text="Текущий режим: —"
                    Foreground="{StaticResource NiatecAccentBrush}"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>

                            <TextBlock
                    x:Name="CurrentDatabaseServerTextBlock"
                    Text="Сервер: —"
                    Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                    x:Name="CurrentDatabaseNameTextBlock"
                    Text="База данных: —"
                    Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                    x:Name="CurrentFilesFolderTextBlock"
                    Text="Папка файлов: —"
                    Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBlock
                    x:Name="CurrentSettingsFileTextBlock"
                    Text="Файл настроек: —"
                    Style="{StaticResource NiatecMutedTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock
            Text="Режим базы данных"
            Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <RadioButton
            x:Name="LocalSqliteRadioButton"
            Content="Локальная база SQLite"
            GroupName="DatabaseMode"
            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                    <RadioButton
            x:Name="SqlServerRadioButton"
            Content="Серверная база SQL Server"
            GroupName="DatabaseMode"
            Foreground="{StaticResource NiatecTextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="14">
                    <TextBlock
                        Text="Параметры SQL Server"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock
                        Text="Укажите строку подключения к SQL Server. После сохранения режима нужно перезапустить приложение."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                    <TextBox
                        x:Name="SqlServerConnectionStringTextBox"
                        Header="Строка подключения"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="90"
                        PlaceholderText="Server=SERVER\SQLEXPRESS;Database=NIATEC_Client;Trusted_Connection=True;TrustServerCertificate=True;"/>

                    <TextBox
                        x:Name="SharedClientFilesFolderTextBox"
                        Header="Общая папка файлов клиентов"
                        PlaceholderText="Например: \\SERVER\NIATEC\ClientFiles"/>

                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Примеры строк подключения"
                                Foreground="{StaticResource NiatecAccentBrush}"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Windows-авторизация:"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBox
                                IsReadOnly="True"
                                Text="Server=SERVER\SQLEXPRESS;Database=NIATEC_Client;Trusted_Connection=True;TrustServerCertificate=True;"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Логин и пароль SQL Server:"
                                Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <TextBox
                                IsReadOnly="True"
                                Text="Server=SERVER\SQLEXPRESS;Database=NIATEC_Client;User Id=niatec_user;Password=пароль;TrustServerCertificate=True;"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="Проверить подключение"
                            Style="{StaticResource NiatecSecondaryButtonStyle}"
                            Click="TestSqlServerConnectionButton_Click"/>

                        <Button
                            Grid.Column="1"
                            Content="Сохранить серверный режим"
                            Style="{StaticResource NiatecPrimaryButtonStyle}"
                            Click="SaveSqlServerModeButton_Click"/>

                        <Button
                            Grid.Column="2"
                            Content="Вернуться к SQLite"
                            Style="{StaticResource NiatecDangerButtonStyle}"
                            Click="UseLocalSqliteButton_Click"/>
                    </Grid>

                    <TextBlock
                        x:Name="DatabaseConnectionStatusTextBlock"
                        Text=""
                        Foreground="{StaticResource NiatecAccentBrush}"
                        TextWrapping="Wrap"/>
                    <Border Style="{StaticResource NiatecInnerPanelBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock
            Text="Перенос локальной базы"
            Foreground="{StaticResource NiatecAccentBrush}"
            FontWeight="SemiBold"/>

                            <TextBlock
            Text="Переносит текущую локальную SQLite-базу и папку ClientFiles в серверную SQL Server-базу. Серверная база должна быть пустой."
            Style="{StaticResource NiatecCaptionTextStyle}"/>

                            <Button
            x:Name="MigrateSqliteToSqlServerButton"
            Content="Перенести SQLite в SQL Server"
            Style="{StaticResource NiatecPrimaryButtonStyle}"
            HorizontalAlignment="Left"
            Click="MigrateSqliteToSqlServerButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>