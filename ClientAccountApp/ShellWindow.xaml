<Window
    x:Class="ClientAccountApp.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NIATEC.Client">

    <NavigationView x:Name="AppNavigationView"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                PaneOpening="AppNavigationView_PaneOpening"
                PaneClosing="AppNavigationView_PaneClosing"
                SelectionChanged="AppNavigationView_SelectionChanged">

        <!-- SolidColorBrush — мутируем Color, объект остаётся тот же -->
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B0F17"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"  Color="#0B0F17"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground"      Color="#0B0F17"/>
        </NavigationView.Resources>

        <NavigationView.MenuItems>

            <!-- Основное -->
            <NavigationViewItemHeader Content="Основное"/>

            <NavigationViewItem x:Name="DashboardNavItem" Tag="dashboard" Content="Главная"
                                ToolTipService.ToolTip="Главная (Ctrl+1)"
                                AccessKey="1">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number1" Modifiers="Control"
                                         Invoked="NavAccelerator_Dashboard_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

            <NavigationViewItem x:Name="ClientsNavItem" Tag="clients" Content="Клиенты"
                                ToolTipService.ToolTip="Клиенты (Ctrl+2)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number2" Modifiers="Control"
                                         Invoked="NavAccelerator_Clients_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

            <NavigationViewItemSeparator/>

            <!-- Работа -->
            <NavigationViewItemHeader Content="Работа"/>

            <NavigationViewItem Tag="contracts" Content="Договоры"
                                ToolTipService.ToolTip="Договоры (Ctrl+3)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number3" Modifiers="Control"
                                         Invoked="NavAccelerator_Contracts_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

            <NavigationViewItem Tag="billing" Content="Начисления"
                                ToolTipService.ToolTip="Начисления (Ctrl+4)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calculator"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number4" Modifiers="Control"
                                         Invoked="NavAccelerator_Billing_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

            <NavigationViewItem Tag="problem-signatures" Content="ЭЦП"
                                ToolTipService.ToolTip="ЭЦП — проблемные подписи (Ctrl+5)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Important"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number5" Modifiers="Control"
                                         Invoked="NavAccelerator_Signatures_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

            <NavigationViewItemSeparator/>

            <!-- Дополнительно -->
            <NavigationViewItemHeader Content="Дополнительно"/>

            <NavigationViewItem Tag="catalog" Content="Справочник"
                                ToolTipService.ToolTip="Справочник услуг (Ctrl+6)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number6" Modifiers="Control"
                                         Invoked="NavAccelerator_Catalog_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

            <NavigationViewItem Tag="tools" Content="Инструменты"
                                ToolTipService.ToolTip="Инструменты (Ctrl+7)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library"/>
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number7" Modifiers="Control"
                                         Invoked="NavAccelerator_Tools_Invoked"/>
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <Grid>
                <!-- Камуфляжный слой: растягивается на всю панель через отрицательные отступы -->
                <Image x:Name="NavCamoImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"
                       Margin="-200,-2000,-200,0"
                       VerticalAlignment="Bottom"/>

                <StackPanel x:Name="PaneFooterContent" Padding="12" Spacing="8">
                    <TextBlock Text="Рабочая организация" Foreground="#8FA0BF" FontSize="12"/>
                    <TextBlock x:Name="ActiveOrganizationFooterTextBlock"
                               Text="Организация не выбрана"
                               Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DatabaseModeFooterTextBlock"
                               Text="База: —"
                               Foreground="#5A7090" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Button Content="Профиль организации"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OpenOrganizationProfileButton_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Content="Сменить организацию"
                            HorizontalAlignment="Stretch"
                            Click="SwitchOrganizationButton_Click"/>
                </StackPanel>
            </Grid>
        </NavigationView.PaneFooter>

        <Frame x:Name="RootFrame"/>
    </NavigationView>
</Window>
