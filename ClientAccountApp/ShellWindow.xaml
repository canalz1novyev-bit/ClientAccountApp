<Window
    x:Class="ClientAccountApp.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NIATEC.Client — закрытая бета">

    <NavigationView x:Name="AppNavigationView"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                PaneOpening="AppNavigationView_PaneOpening"
                PaneClosing="AppNavigationView_PaneClosing"
                SelectionChanged="AppNavigationView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="DashboardNavItem"
                Tag="dashboard"
                Content="Сводка">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            

            <NavigationViewItem
                x:Name="ClientsNavItem"
                Tag="clients"
                Content="Клиенты">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
    Tag="problem-signatures"
    Content="ЭЦП">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Important"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
    Tag="contracts"
    Content="Договоры">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem Content="Инструменты" Tag="tools">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
    Tag="billing"
    Content="Начисления">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calculator"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel
        x:Name="PaneFooterContent"
        Padding="12"
        Spacing="8">

                <TextBlock
            Text="Рабочая организация"
            Foreground="#8F9BB3"
            FontSize="12"/>

                <TextBlock
    x:Name="ActiveOrganizationFooterTextBlock"
    Text="Организация не выбрана"
    Foreground="White"
    FontWeight="SemiBold"
    TextWrapping="Wrap"/>
                <TextBlock
    x:Name="DatabaseModeFooterTextBlock"
    Text="База: —"
    Foreground="#8F9BB3"
    FontSize="12"
    TextWrapping="Wrap"
    Margin="0,4,0,0"/>

                <Button
    Content="Профиль организации"
    HorizontalAlignment="Stretch"
    Click="OpenOrganizationProfileButton_Click"/>

                <Button
            Content="Сменить организацию"
            HorizontalAlignment="Stretch"
            Click="SwitchOrganizationButton_Click"/>
            </StackPanel>
        </NavigationView.PaneFooter>
        <Frame x:Name="RootFrame"/>
    </NavigationView>
</Window>