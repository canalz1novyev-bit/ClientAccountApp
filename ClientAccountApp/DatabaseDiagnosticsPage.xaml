<Page
    x:Class="ClientAccountApp.DatabaseDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border
        Background="{StaticResource NiatecBackgroundBrush}"
        Padding="24">

            <Grid RowSpacing="16">

                <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="Диагностика базы"
                    Style="{StaticResource NiatecPageTitleTextStyle}"/>

                <TextBlock
                    Text="Проверка подключения, режима базы, папки файлов и основных таблиц."
                    Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            </StackPanel>

            <Border
                Grid.Row="1"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Проверка состояния"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock
                        Text="Нажмите кнопку проверки. Приложение проверит текущую базу данных и папку файлов клиентов."
                        Style="{StaticResource NiatecCaptionTextStyle}"/>

                    <Button
                        x:Name="RunDatabaseDiagnosticsButton"
                        Content="Проверить базу и файлы"
                        Style="{StaticResource NiatecPrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="RunDatabaseDiagnosticsButton_Click"/>
                        <Button
    x:Name="SaveDiagnosticsReportButton"
    Content="Сохранить отчёт в файл"
    Style="{StaticResource NiatecSecondaryButtonStyle}"
    HorizontalAlignment="Left"
    Click="SaveDiagnosticsReportButton_Click"/>
                        <TextBlock
                        x:Name="DiagnosticsStatusTextBlock"
                        Text=""
                        Foreground="{StaticResource NiatecAccentBrush}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Результат диагностики"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBox
                        x:Name="DiagnosticsOutputTextBox"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="520"
                        PlaceholderText="Результат проверки появится здесь."/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>