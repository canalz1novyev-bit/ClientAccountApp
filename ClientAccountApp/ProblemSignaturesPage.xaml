<Page
    x:Class="ClientAccountApp.ProblemSignaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientAccountApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0F1115" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="ЭЦП"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                <TextBlock
                    Text="Контроль электронных подписей: действующие, истекающие и просроченные"
                    FontSize="14"
                    Foreground="#B8B8B8"/>
            </StackPanel>

            <ComboBox
                x:Name="ProblemSignatureFilterComboBox"
                Grid.Column="1"
                Header="Фильтр"
                SelectionChanged="ProblemSignatureFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="Все ЭЦП"/>
                <ComboBoxItem Content="Истекает в 30 дней"/>
                <ComboBoxItem Content="Истекает в 7 дней"/>
                <ComboBoxItem Content="Уже истекла"/>
            </ComboBox>

            <Button
                Grid.Column="3"
                Content="Обновить"
                Click="RefreshProblemSignaturesButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#171A21"
                CornerRadius="16"
                Padding="16"
                BorderBrush="#2B3140"
                BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="Электронные подписи"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <ListView
                        x:Name="ProblemSignaturesListView"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="ProblemSignaturesListView_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProblemSignatureItem">
                                <Border
                                    Background="#11151C"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind ClientName}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="White"/>

                                        <TextBlock
                                            Text="{x:Bind Inn}"
                                            Foreground="#B8B8B8"/>

                                        <TextBlock
                                            Text="{x:Bind CertificationAuthority}"
                                            Foreground="#9FB3C8"/>

                                        <TextBlock
                                            Text="{x:Bind ExpiresDateText}"
                                            Foreground="{x:Bind StatusBrush}"/>

                                        <TextBlock
                                            Text="{x:Bind StatusText}"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind StatusBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Background="#171A21"
                CornerRadius="16"
                Padding="16"
                BorderBrush="#2B3140"
                BorderThickness="1">

                <StackPanel Spacing="10">
                    <TextBlock
                        Text="Карточка ЭЦП"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock Text="Клиент" Foreground="#8F9BB3"/>
                    <TextBlock x:Name="ProblemClientNameTextBlock" Text="—" Foreground="White" TextWrapping="Wrap"/>

                    <TextBlock Text="ИНН" Foreground="#8F9BB3"/>
                    <TextBlock x:Name="ProblemInnTextBlock" Text="—" Foreground="White"/>

                    <TextBlock Text="Удостоверяющий центр" Foreground="#8F9BB3"/>
                    <TextBlock x:Name="ProblemAuthorityTextBlock" Text="—" Foreground="White" TextWrapping="Wrap"/>

                    <TextBlock Text="Дата окончания" Foreground="#8F9BB3"/>
                    <TextBlock x:Name="ProblemExpiresTextBlock" Text="—" Foreground="White"/>

                    <TextBlock Text="Статус" Foreground="#8F9BB3"/>
                    <TextBlock x:Name="ProblemStatusTextBlock" Text="—" Foreground="White"/>

                    <TextBlock Text="Комментарий" Foreground="#8F9BB3"/>
                    <TextBlock x:Name="ProblemCommentTextBlock" Text="—" Foreground="White" TextWrapping="Wrap"/>

                    <Button
                        Content="Перейти к клиенту"
                        Click="OpenProblemClientButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>