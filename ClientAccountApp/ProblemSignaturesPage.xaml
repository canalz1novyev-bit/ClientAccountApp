<Page
    x:Class="ClientAccountApp.ProblemSignaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientAccountApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{StaticResource NiatecBackgroundBrush}"
        Padding="24"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и фильтр -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="ЭЦП"
                    Style="{StaticResource NiatecPageTitleTextStyle}"/>

                <TextBlock
                    Text="Контроль электронных подписей: действующие, истекающие и просроченные"
                    Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
            </StackPanel>

            <ComboBox
                x:Name="ProblemSignatureFilterComboBox"
                Grid.Column="1"
                Header="Фильтр"
                SelectionChanged="ProblemSignatureFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="Все ЭЦП"/>
                <ComboBoxItem Content="Истекает в 30 дней"/>
                <ComboBoxItem Content="Истекает в 7 дней"/>
                <ComboBoxItem Content="Уже истекла"/>
            </ComboBox>

            <Button
                Grid.Column="2"
                Content="Обновить"
                Style="{StaticResource NiatecSecondaryButtonStyle}"
                VerticalAlignment="Bottom"
                Click="RefreshProblemSignaturesButton_Click"/>
        </Grid>

        <!-- Основная область -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Список ЭЦП -->
            <Border
                Grid.Column="0"
                Style="{StaticResource NiatecCardBorderStyle}">

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="Электронные подписи"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <ListView
                        x:Name="ProblemSignaturesListView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="ProblemSignaturesListView_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProblemSignatureItem">
                                <Border
                                    Background="{StaticResource NiatecSurfaceAltBrush}"
                                    BorderBrush="{StaticResource NiatecBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind ClientName}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{x:Bind Inn}"
                                            Foreground="{StaticResource NiatecTextSecondaryBrush}"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{x:Bind CertificationAuthority}"
                                            Foreground="{StaticResource NiatecAccentBlueBrush}"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{x:Bind ExpiresDateText}"
                                            Foreground="{x:Bind StatusBrush}"/>

                                        <TextBlock
                                            Text="{x:Bind StatusText}"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind StatusBrush}"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Карточка ЭЦП -->
            <Border
                Grid.Column="1"
                Style="{StaticResource NiatecCardBorderStyle}">

                <StackPanel Spacing="10">
                    <TextBlock
                        Text="Карточка ЭЦП"
                        Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                    <TextBlock Text="Клиент" Style="{StaticResource NiatecCaptionTextStyle}"/>
                    <TextBlock
                        x:Name="ProblemClientNameTextBlock"
                        Text="—"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                        TextWrapping="Wrap"/>

                    <TextBlock Text="ИНН" Style="{StaticResource NiatecCaptionTextStyle}"/>
                    <TextBlock
                        x:Name="ProblemInnTextBlock"
                        Text="—"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                    <TextBlock Text="Удостоверяющий центр" Style="{StaticResource NiatecCaptionTextStyle}"/>
                    <TextBlock
                        x:Name="ProblemAuthorityTextBlock"
                        Text="—"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                        TextWrapping="Wrap"/>

                    <TextBlock Text="Дата окончания" Style="{StaticResource NiatecCaptionTextStyle}"/>
                    <TextBlock
                        x:Name="ProblemExpiresTextBlock"
                        Text="—"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                    <TextBlock Text="Статус" Style="{StaticResource NiatecCaptionTextStyle}"/>
                    <TextBlock
                        x:Name="ProblemStatusTextBlock"
                        Text="—"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"/>

                    <TextBlock Text="Комментарий" Style="{StaticResource NiatecCaptionTextStyle}"/>
                    <TextBlock
                        x:Name="ProblemCommentTextBlock"
                        Text="—"
                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                        TextWrapping="Wrap"/>

                    <Button
                        Content="Перейти к клиенту"
                        Style="{StaticResource NiatecPrimaryButtonStyle}"
                        Click="OpenProblemClientButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>