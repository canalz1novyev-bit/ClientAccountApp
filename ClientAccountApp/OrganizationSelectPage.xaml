<Page
    x:Class="ClientAccountApp.OrganizationSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{StaticResource NiatecBackgroundBrush}"
        Padding="24"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="Выбор организации"
                Style="{StaticResource NiatecPageTitleTextStyle}"/>

            <TextBlock
                Text="Выберите организацию, от имени которой будете работать."
                Style="{StaticResource NiatecPageSubtitleTextStyle}"/>
        </StackPanel>

        <!-- Список организаций -->
        <Border
            Grid.Row="1"
            MaxWidth="900"
            HorizontalAlignment="Left"
            Style="{StaticResource NiatecCardBorderStyle}">

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Text="Доступные организации"
                    Style="{StaticResource NiatecSectionTitleTextStyle}"/>

                <ListView
    x:Name="OrganizationsListView"
    Grid.Row="1"
    SelectionMode="Single"
    SelectionChanged="OrganizationsListView_SelectionChanged"
    Background="Transparent"
    BorderThickness="0">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
    x:Name="OrganizationCardBorder"
    Background="{StaticResource NiatecSurfaceAltBrush}"
    BorderBrush="{StaticResource NiatecBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="14"
    DoubleTapped="OrganizationCardBorder_DoubleTapped">

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NiatecTextPrimaryBrush}"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding Inn}"
                                        Foreground="{StaticResource NiatecAccentBrush}"/>

                                    <TextBlock
                                        Text="{Binding LegalAddress}"
                                        Foreground="{StaticResource NiatecTextMutedBrush}"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Действия -->
        <Border
            Grid.Row="2"
            MaxWidth="900"
            HorizontalAlignment="Left"
            Style="{StaticResource NiatecInnerPanelBorderStyle}">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Content="Войти"
                    Style="{StaticResource NiatecPrimaryButtonStyle}"
                    Click="EnterOrganizationButton_Click"/>

                <Button
                    Grid.Column="1"
                    Content="Добавить организацию"
                    Style="{StaticResource NiatecSecondaryButtonStyle}"
                    Click="AddOrganizationButton_Click"/>

                <TextBlock
                    x:Name="OrganizationSelectStatusTextBlock"
                    Grid.Column="2"
                    Text=""
                    Foreground="{StaticResource NiatecAccentBrush}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Page>