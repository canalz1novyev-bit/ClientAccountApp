<Page
    x:Class="ClientAccountApp.OrganizationSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0F1115" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                Text="Выбор организации"
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="White"/>

            <TextBlock
                Text="Выберите организацию, от имени которой будете работать."
                Foreground="#9AA4B2"
                TextWrapping="Wrap"/>
        </StackPanel>

        <Border
            Grid.Row="2"
            Background="#171A21"
            BorderBrush="#2B3140"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16"
            MaxWidth="900"
            HorizontalAlignment="Left">

            <ListView
                x:Name="OrganizationsListView"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="#11151C"
                            BorderBrush="#243042"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="{Binding Inn}"
                                    Foreground="#D7BA7D"/>

                                <TextBlock
                                    Text="{Binding LegalAddress}"
                                    Foreground="#8F9BB3"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button
                Content="Войти"
                Width="160"
                Click="EnterOrganizationButton_Click"/>

            <Button
                Content="Добавить организацию"
                Width="220"
                Click="AddOrganizationButton_Click"/>

            <TextBlock
                x:Name="OrganizationSelectStatusTextBlock"
                Text=""
                Foreground="#D7BA7D"
                VerticalAlignment="Center"
                TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>